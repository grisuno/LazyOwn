{"uid":"modules/gym_cleanup.py","name":"gym_cleanup.py","qualname":"modules/gym_cleanup.py","kind":"module","file":"modules/gym_cleanup.py","line":1,"end_line":74,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Gym machine cleanup on LazyOwn exit.","description":"Lab scenario containers (``lazyown-lab-*``) and cyber range containers\n(``lazyown-range-*``) hold real memory and CPU on the operator host.\nWhen an interactive operator shell closes through any path (quit, EOF,\nSIGTERM, SIGHUP, atexit) every running gym machine is stopped so\nnothing keeps leasing resources after the session. This is OPT-IN:\n``\"gym_cleanup_on_exit\": true`` in ``payload.json`` enables it.\n\nAutonomous and headless processes (dashboard loop subprocesses,\n``-c`` runs, MCP workers) never stop gym machines — a loop subprocess\nexiting used to kill the gym out from under the next run, which is why\noperators kept finding the lab down after every auto_loop.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/gym_cleanup.py::CONFIG_KEY","modules/gym_cleanup.py::cleanup_enabled","modules/gym_cleanup.py::cleanup_gym_machines"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
