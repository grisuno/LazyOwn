{"uid":"cli/commands/_base.py::LazyOwnCommandSet.__getattr__","name":"__getattr__","qualname":"LazyOwnCommandSet.__getattr__","kind":"method","file":"cli/commands/_base.py","line":112,"end_line":162,"language":"py","signature":"def __getattr__(self, name: str) -> Any","params":[{"name":"name","annotation":"str","default":"","kind":"positional"}],"returns":"Any","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Forward unknown attribute access to the bound shell or utils.","description":"``cmd2`` binds the parent shell to ``self._cmd`` when the\n``CommandSet`` is registered. Migrated methods reference shell\nstate directly (``self.run_script``, ``self.c2_url``, ...) so this\nforwarder lets them execute unmodified once they are wired in.\n\nMigrated ``do_*`` methods also call single-underscore shell helpers\nthat stayed on ``LazyOwnShell`` (``self._scope_save``,\n``self._load_adversaries``, ``self._payload_factory``, ...). Those\nare forwarded to the bound shell as well; only dunder names and\n``complete_*`` completion probes are refused outright, because\nforwarding them would leak Python/cmd2 machinery. Private names are\nnever resolved from ``utils`` — a private helper only ever lives on\nthe shell.\n\nWhen a public name is not on the shell, the forwarder falls back to\nthe ``utils`` module namespace, giving migrated CommandSets access\nto every re-exported symbol (``os``, ``json``, ``glob``,\n``getprompt``, category constants, etc.) without per-file import\nboilerplate.","params":[{"name":"name","type":"","description":"Attribute name requested by the caller.","default":""}],"returns":{"name":"","type":"","description":"The attribute value resolved on the bound shell or utils.","default":""},"yields":null,"raises":[{"name":"AttributeError","type":"","description":"When ``name`` is a dunder or ``complete_*``\nprobe, when the shell is not yet bound (inert before\nregistration), or when neither the shell nor ``utils``\nexpose a public ``name``.","default":""}],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"cli/commands/_base.py::LazyOwnCommandSet","members":[],"inferred_raises":["AttributeError"],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"cli/commands/_base.py::LazyOwnCommandSet.__setattr__","name":"__setattr__","qualname":"LazyOwnCommandSet.__setattr__","kind":"method","file":"cli/commands/_base.py","line":164,"end_line":183,"language":"py","signature":"def __setattr__(self, name: str, value: Any) -> None","params":[{"name":"name","annotation":"str","default":"","kind":"positional"},{"name":"value","annotation":"Any","default":"","kind":"positional"}],"returns":"None","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Forward prompt attribute writes to the bound shell.","description":"The migrated ``do_*`` methods were written against ``LazyOwnShell``\nand assign ``self.custom_prompt`` / ``self.prompt`` expecting the\nshell to hold them. Without forwarding, those writes landed on the\nCommandSet and the Neon Box prompt never refreshed after ``assign``.\nOnly the two prompt names are forwarded; every other attribute stays\non the CommandSet so cmd2 internals remain untouched.","params":[{"name":"name","type":"","description":"Attribute name being set.","default":""},{"name":"value","type":"","description":"Attribute value.","default":""}],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"cli/commands/_base.py::LazyOwnCommandSet","members":[],"inferred_raises":[],"returns_value":false,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
