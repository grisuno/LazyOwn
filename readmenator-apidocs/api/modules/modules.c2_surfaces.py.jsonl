{"uid":"modules/c2_surfaces.py","name":"c2_surfaces.py","qualname":"modules/c2_surfaces.py","kind":"module","file":"modules/c2_surfaces.py","line":1,"end_line":295,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"C2 dashboard surfaces fed by the autonomous loop and APT chains.","description":"Single chokepoint (same philosophy as ``chain_registry`` and the\nexploit catalogue): every automated write to operator-visible C2\nstate — banners, CVEs, notes, event rules, session reports — goes\nthrough here. Reads mirror lazyc2's own formats exactly\n(``sessions/banners.json``, ``sessions/cves.json``,\n``sessions/notes.txt``, ``event_config.json``) so the dashboard needs\nzero changes.\n\nSecurity invariants:\n    1. Appends and dedupes only; never deletes operator content.\n    2. Every write is atomic (tmp + replace) and capped in size.\n    3. Every public function is best-effort and never raises — a full\n       disk or a corrupt JSON must not break an engagement loop.\n    4. No network, no shell, no credentials handled here.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/c2_surfaces.py::publish_banner","modules/c2_surfaces.py::publish_cve","modules/c2_surfaces.py::append_note","modules/c2_surfaces.py::register_loot_event","modules/c2_surfaces.py::refresh_session_report","modules/c2_surfaces.py::severity_to_risk","modules/c2_surfaces.py::group_tasks_for_display"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
