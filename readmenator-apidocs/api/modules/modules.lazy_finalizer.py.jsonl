{"uid":"modules/lazy_finalizer.py","name":"lazy_finalizer.py","qualname":"modules/lazy_finalizer.py","kind":"module","file":"modules/lazy_finalizer.py","line":1,"end_line":200,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Evidence-gated finalization for the autonomous loop and apt_chain.","description":"A task or chain run may report ``done`` while nothing was actually executed and\nno evidence was captured: a worker self-report, an empty LLM turn, or a chain\nwhose steps all abstained. This module is the single gate that decides whether a\nrun may be promoted to a verified, user-facing conclusion. Natural-language or\nstatus-level claims are only candidates until :func:`decide` confirms the run is\nbacked by real execution evidence.\n\nThe contract is pure (no I/O): the caller passes the evidence counts it already\nhas and receives a :class:`FinalizerDecision`. Both autonomous runtimes consume\nit so ``achieved`` never rests on a bare status flag, mirroring the chain\nrunner's per-step ``evidence_observed`` verdict at task scope.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/lazy_finalizer.py::REASON_VERIFIED","modules/lazy_finalizer.py::REASON_MISSING_EVIDENCE","modules/lazy_finalizer.py::REASON_PARTIAL","modules/lazy_finalizer.py::REASON_UNFINISHED","modules/lazy_finalizer.py::REASON_PENDING_APPROVALS","modules/lazy_finalizer.py::REASON_PENDING_STEPS","modules/lazy_finalizer.py::VERDICT_ACHIEVED","modules/lazy_finalizer.py::VERDICT_PARTIAL","modules/lazy_finalizer.py::VERDICT_FAILED","modules/lazy_finalizer.py::FinalizerDecision","modules/lazy_finalizer.py::decide"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
