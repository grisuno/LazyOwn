{"uid":"core/param_registry.py::REGISTRY_HEADER","name":"REGISTRY_HEADER","qualname":"REGISTRY_HEADER","kind":"constant","file":"core/param_registry.py","line":94,"end_line":110,"language":"py","signature":"REGISTRY_HEADER","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"core/param_registry.py","members":[],"inferred_raises":[],"returns_value":null,"value":"'# Operator-declared parameters.\\n#\\n# One place to declare a parameter that every surface can use: lazyaddons\\n# ({param} substitution), aliases, pipelines and the shell `assign` command.\\n# Manage it from the lazy_orchestrator TUI (Params tab) or with\\n# `param create <name> --kind string --default \"\" --desc \"...\"`.\\n#\\n# Format per entry:\\n#   name:\\n#     kind: string          # string|integer|boolean|url|path|ip|port|...\\n#     default: value\\n#     description: \"help text\"\\n#     category: general\\n#\\n# Use generic names: a key only one addon understands belongs in that\\n# addon, not in the shared catalog.\\n'","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
