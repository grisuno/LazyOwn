{"uid":"cli/recommendation_signals.py::KillchainGapSignal","name":"KillchainGapSignal","qualname":"KillchainGapSignal","kind":"class","file":"cli/recommendation_signals.py","line":386,"end_line":528,"language":"py","signature":"class KillchainGapSignal","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Detect missing steps in the kill chain from world model and session state.","description":"Inspects ``sessions/world_model.json`` host states and session artefacts\nto identify gaps where the operator has not progressed. Each detected gap\nproduces a high-confidence :class:`Proposal` for the most impactful next\naction.\n\nGap detection rules (ordered by priority):\n    - Host in EXPLOITED state without privesc output: recommend\n      linpeas/winpeas.\n    - Host in OWNED state without credential dump: recommend\n      mimikatz/secretsdump/lazydump.\n    - Scan XML exists but no enumeration: recommend gobuster/ffuf/enum4linux.\n    - Credentials exist but no lateral movement: recommend\n      crackmapexec/psexec.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"cli/recommendation_signals.py","members":["cli/recommendation_signals.py::KillchainGapSignal.name","cli/recommendation_signals.py::KillchainGapSignal.__init__","cli/recommendation_signals.py::KillchainGapSignal.propose"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
