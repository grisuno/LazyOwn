{"uid":"skills/claude_md_orchestrator/tdd_agent.py","name":"tdd_agent.py","qualname":"skills/claude_md_orchestrator/tdd_agent.py","kind":"module","file":"skills/claude_md_orchestrator/tdd_agent.py","line":1,"end_line":239,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Test-Driven Development agent.","description":"The agent lifts a Spec into a pytest module. The cycle halts at red.\nThe agent will not advance to the next stage until pytest reports a\nfailure for the new tests. The agent never writes a passing test. The\nagent uses the BDD Given When Then structure inside the test function\nso the test name reads as a behaviour.\n\nThe agent writes the test file with a single public function per sad\npath and one extra function for the happy path. The test functions\nimport the implementation module the bdd agent will produce. The\nimplementation module does not exist when the tdd agent runs. The\npytest collection step must fail with an ImportError or an\nassertion. The orchestrator counts the ImportError as a red outcome.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["skills/claude_md_orchestrator/tdd_agent.py::TEST_TEMPLATE","skills/claude_md_orchestrator/tdd_agent.py::TddResult","skills/claude_md_orchestrator/tdd_agent.py::run","skills/claude_md_orchestrator/tdd_agent.py::read_test_source"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"skills/claude_md_orchestrator/tdd_agent.py::TEST_TEMPLATE","name":"TEST_TEMPLATE","qualname":"TEST_TEMPLATE","kind":"constant","file":"skills/claude_md_orchestrator/tdd_agent.py","line":29,"end_line":76,"language":"py","signature":"TEST_TEMPLATE","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"skills/claude_md_orchestrator/tdd_agent.py","members":[],"inferred_raises":[],"returns_value":null,"value":"'\"\"\"Tests generated by the tdd agent for contract {contract_id}.\\n\\nThe tests follow the behaviour the spec documents. The implementation\\nmodule does not exist yet. Every test is expected to fail until the\\nbdd agent produces the source that satisfies it.\\n\"\"\"\\n\\nfrom __future__ import annotations\\n\\nimport importlib\\nimport sys\\nfrom pathlib import Path\\n\\nTEST_FILE = Path(__file__).resolve()\\nSOURCE_ROOT = TEST_FILE.parents[3] / \"runs\" / \"current\" / \"src\"\\nSOURCE_NAME = \"{module_name}\"\\nif str(SOURCE_ROOT) not in sys.path:\\n    sys.path.insert(0, str(SOURCE_ROOT))\\n\\n\\ndef _load_module():\\n    \"\"\"Import the implementation module under test.\\n\\n    Returns:\\n        The implementation module.\\n    Raises:\\n        ImportError: when the module does not exist yet. The tdd\\n            agent counts that error as a red outcome.\\n    \"\"\"\\n    return importlib.import_module(SOURCE_NAME)\\n\\n\\ndef test_happy_path_{contract_id}():\\n    \"\"\"Confirm the happy path outcome matches the spec.\\n\\n    Args:\\n        None.\\n    Returns:\\n        None. The test asserts the contract runtime returns ``ok``.\\n    \"\"\"\\n    module = _load_module()\\n    assert hasattr(module, \"run\")\\n    outcome = module.run()\\n    assert outcome == \"ok\"\\n\\n\\n{test_functions}\\n'","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
