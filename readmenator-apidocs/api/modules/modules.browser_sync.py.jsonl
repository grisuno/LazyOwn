{"uid":"modules/browser_sync.py","name":"browser_sync.py","qualname":"modules/browser_sync.py","kind":"module","file":"modules/browser_sync.py","line":1,"end_line":926,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Browser identity sync between the operator browser and the recorder proxy.","description":"A Chrome/Brave extension (``browser_sync_extension/``) pushes the real\ncookie store plus fingerprint headers (user agent, languages, client\nhints) to a local, token-authenticated receiver exposed by this module.\nThe recorder proxy (:mod:`modules.lazy_proxy`) then calls\n:func:`apply_identity_headers` on every forwarded exchange so the\nautonomous loop, ``apt_chain`` and ``auto_pwn`` reuse the genuine browser\nsession instead of fingerprint-breaking anonymous requests.\n\nBurp-style \"Match and Replace\" rules live in ``sessions/browser_sync/rules.json``\nand are applied after the identity headers, letting the operator rewrite\nany header or body region of the proxied traffic.\n\nSecurity contract: the receiver binds loopback only, requires a runtime\ngenerated token, caps request size, sanitises every stored header value\nand never raises on I/O; a broken sync degrades to anonymous traffic.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/browser_sync.py::DEFAULT_SYNC_HOST","modules/browser_sync.py::DEFAULT_SYNC_PORT","modules/browser_sync.py::SYNC_DIR_NAME","modules/browser_sync.py::ENDPOINT_PATH","modules/browser_sync.py::HEALTH_PATH","modules/browser_sync.py::TOKEN_HEADER","modules/browser_sync.py::TOKEN_BYTES","modules/browser_sync.py::MAX_SYNC_BODY","modules/browser_sync.py::MAX_SYNC_DRAIN","modules/browser_sync.py::MAX_COOKIES","modules/browser_sync.py::MAX_COOKIE_VALUE","modules/browser_sync.py::MAX_HEADER_VALUE","modules/browser_sync.py::MAX_RULES","modules/browser_sync.py::PROFILE_TTL_SEC","modules/browser_sync.py::DEFAULT_INJECT","modules/browser_sync.py::INJECTABLE_HEADER_PREFIXES","modules/browser_sync.py::token","modules/browser_sync.py::reset_token","modules/browser_sync.py::load_profile","modules/browser_sync.py::profile_stats","modules/browser_sync.py::cookie_matches_host","modules/browser_sync.py::cookie_matches_path","modules/browser_sync.py::cookie_expired","modules/browser_sync.py::cookies_for_host","modules/browser_sync.py::build_cookie_header","modules/browser_sync.py::write_netscape_jar","modules/browser_sync.py::jar_path","modules/browser_sync.py::WIRING_ENABLED","modules/browser_sync.py::apply_rules","modules/browser_sync.py::apply_identity_headers","modules/browser_sync.py::SyncReceiver","modules/browser_sync.py::get_receiver","modules/browser_sync.py::start_receiver","modules/browser_sync.py::stop_receiver","modules/browser_sync.py::clear_profile","modules/browser_sync.py::apply_identity_to_url","modules/browser_sync.py::ensure_wiring","modules/browser_sync.py::masked_rows"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
