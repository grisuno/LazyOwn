{"uid":"skills/claude_md_orchestrator/cicd_agent.py::PIPELINE_TEMPLATE","name":"PIPELINE_TEMPLATE","qualname":"PIPELINE_TEMPLATE","kind":"constant","file":"skills/claude_md_orchestrator/cicd_agent.py","line":29,"end_line":67,"language":"py","signature":"PIPELINE_TEMPLATE","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"skills/claude_md_orchestrator/cicd_agent.py","members":[],"inferred_raises":[],"returns_value":null,"value":"\"name: orchestrator-{contract_id}\\n\\non:\\n  pull_request:\\n    branches: [dev]\\n  push:\\n    branches: [feature/{slug}]\\n\\npermissions:\\n  contents: read\\n\\njobs:\\n  test:\\n    name: orchestrator-{contract_id}\\n    runs-on: ubuntu-latest\\n    strategy:\\n      fail-fast: false\\n      matrix:\\n        python-version: ['3.11']\\n    steps:\\n      - uses: actions/checkout@v4\\n      - name: Set up Python\\n        uses: actions/setup-python@v5\\n        with:\\n          python-version: ${{ matrix.python-version }}\\n          cache: pip\\n      - name: Install dev deps\\n        run: |\\n          python -m pip install --upgrade pip\\n          pip install -r requirements-dev.txt\\n      - name: Run ruff\\n        run: ruff check {test_path} {source_path}\\n      - name: Run mypy\\n        run: mypy --ignore-missing-imports {test_path} {source_path}\\n      - name: Run bandit\\n        run: bandit -q {source_path}\\n      - name: Run pytest\\n        run: pytest -q {test_path}\\n\"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
