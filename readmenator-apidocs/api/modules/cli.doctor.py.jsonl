{"uid":"cli/doctor.py","name":"doctor.py","qualname":"cli/doctor.py","kind":"module","file":"cli/doctor.py","line":1,"end_line":617,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Environment health check (preflight doctor) for the LazyOwn framework.","description":"Complements the setup wizard. Where ``wizard`` / ``wizard --check`` validate the\noperator's *configuration* (the values in ``payload.json``), ``doctor`` validates\nthe *installation* itself: the running Python version, whether the virtual\nenvironment is active, importability of the third-party packages that\n``install.sh`` provisions, the presence of the C2 TLS certificates, the\n``payload.json`` config file, the SecLists wordlists, and the external kill-chain\ntooling.\n\nDesign contract:\n    - Zero imports from ``lazyown.py`` or ``lazyc2.py`` (Dependency Inversion);\n      the command surface depends on this module, never the reverse.\n    - Pure check functions return :class:`CheckResult` objects and never print,\n      so they are unit-testable without capturing stdout. Rendering is isolated\n      in :func:`render_report`.\n    - External-tool and SecLists detection is delegated to :mod:`cli.wizard` so\n      the framework keeps a single source of truth for those checks (DRY).\n    - System-touching dependencies (the package finder, the binary checker, the\n      filesystem root) are injected so tests can stub them deterministically.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["cli/doctor.py::PackageSpec","cli/doctor.py::CheckResult","cli/doctor.py::DoctorReport","cli/doctor.py::check_python_version","cli/doctor.py::check_virtualenv","cli/doctor.py::check_packages","cli/doctor.py::check_certificates","cli/doctor.py::check_payload","cli/doctor.py::check_seclists","cli/doctor.py::check_command_index","cli/doctor.py::check_external_tools","cli/doctor.py::gather_report","cli/doctor.py::render_report","cli/doctor.py::run","cli/doctor.py::fix_report"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
