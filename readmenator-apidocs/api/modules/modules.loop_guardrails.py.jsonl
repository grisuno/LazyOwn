{"uid":"modules/loop_guardrails.py::EdrPacer","name":"EdrPacer","qualname":"EdrPacer","kind":"class","file":"modules/loop_guardrails.py","line":190,"end_line":464,"language":"py","signature":"class EdrPacer","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Defense-aware pacing driven by observed execution anomalies.","description":"The pacer never blocks by itself: it only recommends. ``observe``\nfeeds one executed command with its wall-clock duration and output;\nthe internal score decays over time so a single anomaly does not\npermanently slow the loop.\n\nDelays are fully configurable through the orchestrator ``pacing``\nblock (see ``orchestrator_config.pacing``): per-level quiet ranges,\na jitter percentage applied to every drawn delay and ``HH:MM-HH:MM``\nsleeper windows during which the recommended delay extends to the\nwindow end (clamped to ``max_delay_sec`` so callers re-check the\nwindow instead of oversleeping a cancellation).","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"modules/loop_guardrails.py","members":["modules/loop_guardrails.py::EdrPacer.__init__","modules/loop_guardrails.py::EdrPacer.parse_windows","modules/loop_guardrails.py::EdrPacer.from_config","modules/loop_guardrails.py::EdrPacer.observe","modules/loop_guardrails.py::EdrPacer.decay","modules/loop_guardrails.py::EdrPacer.level","modules/loop_guardrails.py::EdrPacer.signal","modules/loop_guardrails.py::EdrPacer.in_sleeper_window","modules/loop_guardrails.py::EdrPacer.windows_delay","modules/loop_guardrails.py::EdrPacer.sleeper_delay","modules/loop_guardrails.py::EdrPacer.inter_step_delay","modules/loop_guardrails.py::EdrPacer.quieten","modules/loop_guardrails.py::EdrPacer.describe"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
