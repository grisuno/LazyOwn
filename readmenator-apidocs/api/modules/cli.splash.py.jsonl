{"uid":"cli/splash.py::TypewriterEffect","name":"TypewriterEffect","qualname":"TypewriterEffect","kind":"class","file":"cli/splash.py","line":80,"end_line":116,"language":"py","signature":"class TypewriterEffect","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Print each character of each line with a fixed delay.","description":"A blinking caret is appended to the active line so the\noperator sees the typewriter working. The caret is removed\nbefore the function returns. The accumulated prefix is\nredrawn on every step so the operator sees the line growing\nleft-to-right, not single characters flickering.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"cli/splash.py","members":["cli/splash.py::TypewriterEffect.render"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
