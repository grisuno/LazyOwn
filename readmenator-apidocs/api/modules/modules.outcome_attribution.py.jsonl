{"uid":"modules/outcome_attribution.py","name":"outcome_attribution.py","qualname":"modules/outcome_attribution.py","kind":"module","file":"modules/outcome_attribution.py","line":1,"end_line":226,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Observer-style failure attribution for autonomous loop steps.","description":"Every executed step is classified into ``ok``, ``blocked`` or ``error`` so the\nplanner can change strategy instead of hammering a defence. ``blocked`` means\nthe target actively refused (a WAF, a 403/429, a rate limiter) rather than the\nhost tooling failing; that distinction is what lets the loop pivot verbs at a\nweb application firewall instead of re-issuing the same request until the budget\ndrains.\n\nThe per-verb tally is persisted so a verb the target has repeatedly blocked can\nbe demoted on the next planner round. Host anti-virus and EDR detections are\ndeliberately out of scope here: those belong to ``reactive_engine`` which\nescalates evasion. This module only attributes target-side refusal and tooling\nfailure, and never imports the loop runtime so it stays cycle-free.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/outcome_attribution.py::OK","modules/outcome_attribution.py::BLOCKED","modules/outcome_attribution.py::ERROR","modules/outcome_attribution.py::classify","modules/outcome_attribution.py::verb_of","modules/outcome_attribution.py::AttributionLedger"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
