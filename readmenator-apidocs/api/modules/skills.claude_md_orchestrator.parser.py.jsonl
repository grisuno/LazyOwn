{"uid":"skills/claude_md_orchestrator/parser.py","name":"parser.py","qualname":"skills/claude_md_orchestrator/parser.py","kind":"module","file":"skills/claude_md_orchestrator/parser.py","line":1,"end_line":248,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Parser that turns a CLAUDE.md into actionable contracts.","description":"The parser is deterministic. It does not call any LLM. It walks the\nmarkdown as a tree of sections and lifts every actionable bullet that\nlives under a heading that carries a flag. The flag is the keyword\nCONTRACT in the heading text. The orchestrator does not assume the\nmarkdown is well formed. The parser records every malformed input and\nreturns a structured error alongside the partial result.\n\nThe parser also produces the rationale for each contract by combining\nthe parent section text with the first paragraph of the body. The\ndocumentation agent can quote the source verbatim.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["skills/claude_md_orchestrator/parser.py::CONTRACT_HEADING_PATTERN","skills/claude_md_orchestrator/parser.py::CONTRACT_TAG_PATTERN","skills/claude_md_orchestrator/parser.py::CONTRACT_ID_PATTERN","skills/claude_md_orchestrator/parser.py::BULLET_PATTERN","skills/claude_md_orchestrator/parser.py::NUMBERED_PATTERN","skills/claude_md_orchestrator/parser.py::HEADING_ID_DERIVE","skills/claude_md_orchestrator/parser.py::parse_claude_md","skills/claude_md_orchestrator/parser.py::load_contracts"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
