{"uid":"modules/logging_config.py::ResilientRotatingFileHandler","name":"ResilientRotatingFileHandler","qualname":"ResilientRotatingFileHandler","kind":"class","file":"modules/logging_config.py","line":103,"end_line":131,"language":"py","signature":"class ResilientRotatingFileHandler(logging.handlers.RotatingFileHandler)","params":[],"returns":"","decorators":[],"bases":["logging.handlers.RotatingFileHandler"],"modifiers":[],"visibility":"public","doc":{"summary":"RotatingFileHandler that degrades gracefully when the log file becomes unwritable mid-session.","description":"``fast_run_as_r00t.sh`` runs the framework as root while the chown\nwatcher periodically re-owns the tree to the operator UID, so the log\nfile can flip ownership and start raising ``PermissionError``. The base\n``BaseRotatingHandler.emit`` catches that failure and calls\n``handleError``, which by default prints a full traceback for every log\nrecord. This subclass overrides ``handleError`` to emit a single stderr\nnotice instead, and skips every subsequent record.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"modules/logging_config.py","members":["modules/logging_config.py::ResilientRotatingFileHandler.emit","modules/logging_config.py::ResilientRotatingFileHandler.handleError"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":["modules/logging_config.py::configure"]}
