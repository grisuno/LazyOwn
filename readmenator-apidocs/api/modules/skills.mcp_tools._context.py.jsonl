{"uid":"skills/mcp_tools/_context.py","name":"_context.py","qualname":"skills/mcp_tools/_context.py","kind":"module","file":"skills/mcp_tools/_context.py","line":1,"end_line":74,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Dependency-injection context handed to every ``mcp_tools`` handler.","description":"Each tool module under :mod:`mcp_tools` is import-pure: it declares a\n``TOOL`` schema and a ``handle(arguments, tool_name, ctx)`` function and\nimports nothing from the multi-thousand-line ``lazyown_mcp`` runtime. The\nruntime builds one :class:`MCPContext` bundling the shared helpers and\npasses it in, so a tool file never imports the runtime and no circular\nimport can form. New shared helpers are added here as a field when a\nmigrated tool first needs them, keeping the contract explicit and typed.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["skills/mcp_tools/_context.py::MCPContext"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
