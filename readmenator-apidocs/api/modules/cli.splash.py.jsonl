{"uid":"cli/splash.py::InstantEffect","name":"InstantEffect","qualname":"InstantEffect","kind":"class","file":"cli/splash.py","line":141,"end_line":159,"language":"py","signature":"class InstantEffect","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Print every line at once with no animation.","description":"Used in tests.\n\nThe effect renders and returns immediately so unit tests do\nnot have to mock :func:`time.sleep`. ``render_splash`` picks\nthis effect whenever ``config.total_seconds <= 0`` or the\ncaller asks for it explicitly.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"cli/splash.py","members":["cli/splash.py::InstantEffect.render"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
