{"uid":"modules/lazy_runner.py::loop_exit_code","name":"loop_exit_code","qualname":"loop_exit_code","kind":"function","file":"modules/lazy_runner.py","line":566,"end_line":606,"language":"py","signature":"def loop_exit_code(result: dict) -> int","params":[{"name":"result","annotation":"dict","default":"","kind":"positional"}],"returns":"int","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Map one loop summary to an honest process exit code.","description":"A loop that only exhausted its rounds, timed out or stopped in a\nhandoff is not a success: the dashboard marks loops on exit code, so\nthis mapping keeps the finished/failed distinction truthful. The one\npromotion: when the independent verdict is ``achieved`` with\nverified evidence (a confirmed shell, captured credential), the run\ncounts as success even if the engine merely exhausted its rounds.","params":[{"name":"result","type":"","description":"Orchestrator summary.","default":""}],"returns":{"name":"","type":"","description":"``0`` when the run reached a success status or proven achieved\nevidence; ``4`` on timeout and ``1`` for every other ending.","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"modules/lazy_runner.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":["modules/lazy_runner.py::autonomous_exit_gate"]}
