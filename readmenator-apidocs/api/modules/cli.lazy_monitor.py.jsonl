{"uid":"cli/lazy_monitor.py","name":"lazy_monitor.py","qualname":"cli/lazy_monitor.py","kind":"module","file":"cli/lazy_monitor.py","line":1,"end_line":611,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Live worker-visibility monitor for the autonomous loop.","description":"The loop is never a black box: every worker's tool calls, results,\nguard decisions, approvals, traffic and findings stream into a\nmulti-pane Textual view. Two modes share the same rendering:\n\n- attach (``lazy_view [task]``): tails the task's store files, so it\n  works from a second terminal while ``lazy_loop`` runs elsewhere and\n  keeps working after the run for audit;\n- embedded (``lazy_loop --view``): the runner starts the engine inside\n  this app and also streams the executor's raw output live.\n\nKeys: ``q`` quit, ``p``/``r`` pause/resume, ``a``/``d`` approve/deny\nfirst pending intercept, ``h`` hint, ``s`` steer, ``k`` kill, ``f``\nfindings, ``g`` guard, ``t`` traffic, ``1``..``5`` focus a worker.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["cli/lazy_monitor.py::LazyMonitorApp","cli/lazy_monitor.py::run_monitor_command","cli/lazy_monitor.py::run_monitor_session"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
