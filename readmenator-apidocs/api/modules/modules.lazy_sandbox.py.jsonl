{"uid":"modules/lazy_sandbox.py","name":"lazy_sandbox.py","qualname":"modules/lazy_sandbox.py","kind":"module","file":"modules/lazy_sandbox.py","line":1,"end_line":282,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Per-task Docker sandbox for the Lazy autonomous loop.","description":"Ports the per-flow container idea with Lazy semantics: one container per\nloop task, built from the existing ``Dockerfile.sandbox`` image\n(``lazyown-sandbox`` by default, the same tag ``./run`` uses), with the\nrepository mounted at ``/app`` exactly like the documented sandbox usage.\nWorkers keep issuing Lazy shell verbs; the sandbox executor pipes each\nverb into the in-container shell over stdin (``<verb>`` + ``exit``) and\ncaptures the cleaned output, so Guard, scope, traffic and intel see the\nsame transcript shape as host execution.\n\nSafety profile: no privileged flag, all capabilities dropped except\n``NET_RAW`` (nmap needs raw sockets), memory/CPU caps, operator-owned\nnetwork selection. The image is never auto-built inside a round (a build\ntakes minutes and would wedge the loop); a missing image returns a\ncapability-style error the worker records as a fact.\n\nStdlib only. All Docker interaction goes through the ``docker`` CLI so no\nSDK dependency is needed.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/lazy_sandbox.py::image_name","modules/lazy_sandbox.py::container_name","modules/lazy_sandbox.py::docker_available","modules/lazy_sandbox.py::image_available","modules/lazy_sandbox.py::container_running","modules/lazy_sandbox.py::ensure_container","modules/lazy_sandbox.py::exec_command","modules/lazy_sandbox.py::remove_container","modules/lazy_sandbox.py::status","modules/lazy_sandbox.py::executor_for"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
