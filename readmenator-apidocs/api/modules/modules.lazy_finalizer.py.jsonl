{"uid":"modules/lazy_finalizer.py::decide","name":"decide","qualname":"decide","kind":"function","file":"modules/lazy_finalizer.py","line":72,"end_line":185,"language":"py","signature":"def decide(status: str, candidate_verdict: str, facts: int, findings: int, confirmed: int, tested: int, pending_approvals: list[str] | None = None, pending_plan_steps: list[str] | None = None) -> FinalizerDecision","params":[{"name":"status","annotation":"str","default":"","kind":"positional"},{"name":"candidate_verdict","annotation":"str","default":"","kind":"positional"},{"name":"facts","annotation":"int","default":"","kind":"positional"},{"name":"findings","annotation":"int","default":"","kind":"positional"},{"name":"confirmed","annotation":"int","default":"","kind":"positional"},{"name":"tested","annotation":"int","default":"","kind":"positional"},{"name":"pending_approvals","annotation":"list[str] | None","default":"None","kind":"positional"},{"name":"pending_plan_steps","annotation":"list[str] | None","default":"None","kind":"positional"}],"returns":"FinalizerDecision","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Return the evidence-gated finalization decision for a run.","description":"A run is evidence-verified when it produced confirmed findings, or findings\nplus tested coverage, or facts plus tested coverage. A run that claims\n``done`` with none of these is downgraded: the status is a self-report the\nevidence does not support, so the verdict cannot stay ``achieved``.\n\nHard blocking rule (finalization contract): any undecided human approval\nor any still-open plan step prevents ``achieved`` regardless of evidence,\nbecause the run is not actually finished; the verdict degrades to\n``partial`` with the blocking reason named.","params":[{"name":"status","type":"","description":"Engine status of the run (``done`` is the only promotable one).","default":""},{"name":"candidate_verdict","type":"","description":"The verdict the caller would assign before gating.","default":""},{"name":"facts","type":"","description":"Count of non-cold facts recorded.","default":""},{"name":"findings","type":"","description":"Count of findings recorded.","default":""},{"name":"confirmed","type":"","description":"Count of confirmed or reproduced findings.","default":""},{"name":"tested","type":"","description":"Count of assets with at least one completed probe.","default":""},{"name":"pending_approvals","type":"","description":"Undecided approval request ids.","default":""},{"name":"pending_plan_steps","type":"","description":"Open plan step identifiers.","default":""}],"returns":{"name":"","type":"","description":"A :class:`FinalizerDecision` whose ``verdict`` never exceeds what the\nevidence and the pending-work state support.","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"modules/lazy_finalizer.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["modules/lazy_finalizer.py::FinalizerDecision"],"called_by":[]}
