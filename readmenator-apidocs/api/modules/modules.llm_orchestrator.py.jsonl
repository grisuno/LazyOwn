{"uid":"modules/llm_orchestrator.py","name":"llm_orchestrator.py","qualname":"modules/llm_orchestrator.py","kind":"module","file":"modules/llm_orchestrator.py","line":1,"end_line":546,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Orchestrator-governed LLM failover chain for every AI module.","description":"Single entry point the framework's AI consumers use to reach a language\nmodel. The failover chain is owned by ``lazy_orchestrator`` (the Models\ntab) and persisted in ``sessions/lazy/llm_pool.json``; member priority\nacts as the weight deciding the try order. Each leg executes through the\n``modules.llm_factory`` model-spec executor (``groq:``, ``ollama:``,\n``llamacpp:``, ``pi:``, ``toposwarm:``), so a dead Groq key, an exhausted\nquota or a missing API key degrades to the next member instead of\nbreaking the caller. The chain never raises: total exhaustion returns a\nhelp message the caller can display.\n\nContracts\n---------\n* :func:`pool_chain` — ordered members read from the lazy_orchestrator pool.\n* :func:`sort_members` — weight-sorted defensive copy of a member list.\n* :func:`backend_kind` — provider prefix derived from a model spec.\n* :func:`complete_with_fallback` — the failover walk returning an\n  :class:`OrchestratorResult` with a fallback notice when the primary\n  failed.\n* :data:`HELP_MESSAGE` — the final-resort guidance text.\n\nUsage::\n\n    from modules.llm_orchestrator import complete_with_fallback\n\n    result = complete_with_fallback(\"summarize the nmap output\", max_tokens=800)\n    if result.ok:\n        print(result.display_text)","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/llm_orchestrator.py::HELP_MESSAGE","modules/llm_orchestrator.py::OrchestratorResult","modules/llm_orchestrator.py::sort_members","modules/llm_orchestrator.py::pool_chain","modules/llm_orchestrator.py::backend_kind","modules/llm_orchestrator.py::complete_with_fallback"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"modules/llm_orchestrator.py::HELP_MESSAGE","name":"HELP_MESSAGE","qualname":"HELP_MESSAGE","kind":"constant","file":"modules/llm_orchestrator.py","line":78,"end_line":84,"language":"py","signature":"HELP_MESSAGE","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"modules/llm_orchestrator.py","members":[],"inferred_raises":[],"returns_value":null,"value":"'No AI backend answered. Fix options:\\n1. Set a Groq API key: assign api_key gsk_... in LazyOwn, or export GROQ_API_KEY.\\n2. Start a local Ollama server: ollama serve, then ollama pull deepseek-r1:1.5b.\\n3. Start a llama.cpp server (OpenAI-compatible) on 127.0.0.1:8080.\\n4. Manage the failover chain and its weights with lazy_orchestrator (Models tab).\\n'","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"modules/llm_orchestrator.py::OrchestratorResult","name":"OrchestratorResult","qualname":"OrchestratorResult","kind":"class","file":"modules/llm_orchestrator.py","line":92,"end_line":127,"language":"py","signature":"class OrchestratorResult","params":[{"name":"text","annotation":"str","default":"","kind":"positional"},{"name":"member","annotation":"str","default":"''","kind":"positional"},{"name":"model","annotation":"str","default":"''","kind":"positional"},{"name":"model_name","annotation":"str","default":"''","kind":"positional"},{"name":"backend","annotation":"str","default":"'error'","kind":"positional"},{"name":"fallback_used","annotation":"bool","default":"False","kind":"positional"},{"name":"notice","annotation":"str","default":"''","kind":"positional"},{"name":"attempts","annotation":"list[tuple[str, str]]","default":"field(default_factory=list)","kind":"positional"},{"name":"attempted_specs","annotation":"list[str]","default":"field(default_factory=list)","kind":"positional"}],"returns":"","decorators":["dataclass"],"bases":[],"modifiers":["dataclass"],"visibility":"public","doc":{"summary":"Outcome of one orchestrator chain walk.","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[{"name":"text","type":"","description":"Clean model answer; the help message on total failure.","default":""},{"name":"member","type":"","description":"Name of the serving pool member (empty on failure).","default":""},{"name":"model","type":"","description":"Full model spec of the serving member (empty on failure).","default":""},{"name":"model_name","type":"","description":"Model spec without the provider prefix.","default":""},{"name":"backend","type":"","description":"Provider prefix of the serving member or ``\"error\"``.","default":""},{"name":"fallback_used","type":"","description":"True when anything but the primary served.","default":""},{"name":"notice","type":"","description":"Operator-facing message naming failures and the serv