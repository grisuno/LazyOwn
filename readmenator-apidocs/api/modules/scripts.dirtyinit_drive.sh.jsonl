{"uid":"scripts/dirtyinit_drive.sh","name":"dirtyinit_drive.sh","qualname":"scripts/dirtyinit_drive.sh","kind":"module","file":"scripts/dirtyinit_drive.sh","line":1,"end_line":562,"language":"sh","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"dirtyinit_drive.sh - operator-side driver for the DirtyInit Android root chain.","description":"DirtyInit (https://github.com/combeng6th/DirtyInit) escalates a stock user app to the init namespace (u:r:init:s0) on Samsung devices. Upstream ships an app and two native sources but no build system, and the README leaves the device choreography to the operator. This driver closes that gap:  build    cross-compile the init-namespace client + libdfi_exploit.so and pack the APK with the NDK and the Android SDK build-tools install  adb install the APK and grant the storage appop launch   start the exploit activity auto     launch, tap EXECUTE EXPLOIT and EXTRACT CLI via uiautomator extract  pull the client from /sdcard stage    push the client to an exec-capable device path run      execute a command in the init namespace status   report the whole pipeline state  Usage: dirtyinit_drive.sh [--serial <adb-serial>] <action> [args]  Actions: doctor              toolchain and device report build               cross-compile the client and pack the APK install             adb install the APK and grant the storage appop launch              start the exploit activity auto                launch, tap EXECUTE EXPLOIT and EXTRACT CLI extract             pull the client from /sdcard stage               push the client to an exec-capable device path run <cmd> [args]    run a command in the init namespace","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["scripts/dirtyinit_drive.sh::log","scripts/dirtyinit_drive.sh::warn","scripts/dirtyinit_drive.sh::die","scripts/dirtyinit_drive.sh::payload_value","scripts/dirtyinit_drive.sh::parse_flags","scripts/dirtyinit_drive.sh::require_adb","scripts/dirtyinit_drive.sh::require_device","scripts/dirtyinit_drive.sh::find_sdk","scripts/dirtyinit_drive.sh::find_ndk","scripts/dirtyinit_drive.sh::find_build_tools","scripts/dirtyinit_drive.sh::find_android_jar","scripts/dirtyinit_drive.sh::find_ndk_clang","scripts/dirtyinit_drive.sh::find_java_tool","scripts/dirtyinit_drive.sh::pack_apk","scripts/dirtyinit_drive.sh::compile_activity","scripts/dirtyinit_drive.sh::do_build","scripts/dirtyinit_drive.sh::do_install","scripts/dirtyinit_drive.sh::do_launch","scripts/dirtyinit_drive.sh::tap_button","scripts/dirtyinit_drive.sh::do_auto","scripts/dirtyinit_drive.sh::do_extract","scripts/dirtyinit_drive.sh::do_stage","scripts/dirtyinit_drive.sh::do_run","scripts/dirtyinit_drive.sh::do_logs","scripts/dirtyinit_drive.sh::do_status","scripts/dirtyinit_drive.sh::do_doctor","scripts/dirtyinit_drive.sh::do_help","scripts/dirtyinit_drive.sh::main"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
