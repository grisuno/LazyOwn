{"uid":"modules/professional_report.py","name":"professional_report.py","qualname":"modules/professional_report.py","kind":"module","file":"modules/professional_report.py","line":1,"end_line":1068,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Professional Red Team Report Generator.","description":"Produces client-ready pentest/red-team reports in HTML, PDF, and Markdown\nformats. Reads from the world model, session data, and credential stores to\nauto-generate structured findings with CVSS scores, evidence, and\nremediation recommendations.\n\nArchitecture:\n    DataCollector -> FindingClassifier -> RiskScorer -> ReportAssembler -> OutputWriter\n\nOutput formats:\n    HTML  — standalone responsive page with collapsible sections and dark mode.\n    PDF   — via wkhtmltopdf (if available) or weasyprint.\n    MD    — markdown for further editing or wiki integration.\n    JSON  — machine-readable findings for API/CI integration.\n\nSecurity:\n    No credentials in rendered reports by default — only usernames and hashes\n    are included if ``include_credentials`` is explicitly set.\n\nUsage:\n    from modules.professional_report import RedTeamReportGenerator\n    gen = RedTeamReportGenerator()\n    gen.generate(output_dir=\"reports/\")","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/professional_report.py::ReportFinding","modules/professional_report.py::ReportMetadata","modules/professional_report.py::RedTeamReportGenerator"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
