{"uid":"modules/integrations/searchsploit.py","name":"searchsploit.py","qualname":"modules/integrations/searchsploit.py","kind":"module","file":"modules/integrations/searchsploit.py","line":1,"end_line":398,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"modules/integrations/searchsploit.py ====================================== Bridges searchsploit CLI and ExploitDB with LazyOwn CVE/finding data.","description":"Design (SOLID)\n--------------\n- Single Responsibility : each class owns one source or one operation\n- Open/Closed           : new exploit sources via ExploitSource subclass\n- Liskov                : SearchsploitCLI and ExploitDBAPI honour the same contract\n- Interface Segregation : consumers import ExploitSource, not concrete types\n- Dependency Inversion  : SearchsploitClient depends on ExploitSource abstraction\n\nUsage\n-----\n    from modules.integrations.searchsploit import get_client, search_cve\n\n    entries = search_cve(\"CVE-2021-41773\")\n    for e in entries:\n        print(e.id, e.title)\n\n    # CLI:\n    python3 modules/integrations/searchsploit.py --cve CVE-2021-41773\n    python3 modules/integrations/searchsploit.py --service apache --version 2.4.49","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/integrations/searchsploit.py::ExploitEntry","modules/integrations/searchsploit.py::ExploitSource","modules/integrations/searchsploit.py::SearchsploitCLI","modules/integrations/searchsploit.py::ExploitDBAPI","modules/integrations/searchsploit.py::SearchsploitClient","modules/integrations/searchsploit.py::get_client","modules/integrations/searchsploit.py::search_cve","modules/integrations/searchsploit.py::search_service"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called