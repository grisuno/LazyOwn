{"uid":"cli/sessions_browser.py","name":"sessions_browser.py","qualname":"cli/sessions_browser.py","kind":"module","file":"cli/sessions_browser.py","line":1,"end_line":417,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Textual browser for the LazyOwn ``sessions/`` directory.","description":"The browser turns ``sessions/`` into a navigable surface so the operator\nno longer needs to leave the shell to inspect credentials, hashes,\nvulns, notes, or raw nmap output. Files are categorised, listed in a\nleft pane, and previewed in a right pane with bounded reads to keep the\nTUI responsive on multi-megabyte transcripts.\n\nDesign (SOLID):\n\n- Single Responsibility: :class:`SessionsBrowserConfig` owns constants,\n  :class:`SessionEntry` is the immutable record, :class:`SessionsIndex`\n  classifies files, :class:`SessionPreview` returns bounded text, and\n  :class:`SessionsBrowserApp` renders.\n- Open/Closed: a new category is one entry in\n  :attr:`SessionsBrowserConfig.categories`.\n- Dependency Inversion: the app is always constructed from a state\n  object so tests exercise the data layer without Textual.\n- No magic numbers / hardcoded paths: every value lives in the config.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["cli/sessions_browser.py::CategorySpec","cli/sessions_browser.py::SessionsBrowserConfig","cli/sessions_browser.py::SessionEntry","cli/sessions_browser.py::SessionsIndex","cli/sessions_browser.py::SessionPreview","cli/sessions_browser.py::SessionsBrowserState","cli/sessions_browser.py::build_state","cli/sessions_browser.py::launch_browser"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
