{"uid":"cli/commands/bof_registry.py","name":"bof_registry.py","qualname":"cli/commands/bof_registry.py","kind":"module","file":"cli/commands/bof_registry.py","line":1,"end_line":656,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"BOF marketplace CommandSet — Beacon Object File discovery, staging and delivery.","description":"Exposes :mod:`modules.bof_registry` and :mod:`modules.bof_delivery`\nthrough the LazyOwn CLI. Every BOF is declared in ``bofs/*.yaml`` with\nits lazyaddon beacon client (``beacon`` or ``blacksandbeacon``); these\ncommands administer that contract end to end:\n\n    - bof_stage: locate the compiled artifact through the client addon\n      and stage it in sessions/temp_uploads/bofs/\n    - bof_run: build the ``bof:`` command, queue it on the C2, optionally\n      await the result from the beacon history\n    - bof_deploy: deliver a staged client beacon onto a target reached by\n      an atomic session and wait for its first check-in\n    - bof_beacons / bof_results: beacon snapshot and BOF result history\n    - bof_search / bof_info / bof_catalog / bof_list / bof_install /\n      bof_uninstall: catalog administration","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["cli/commands/bof_registry.py::BofMarketplaceCommandSet"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
