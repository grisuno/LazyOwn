{"uid":"modules/lazy_runner.py::bind_target_authority","name":"bind_target_authority","qualname":"bind_target_authority","kind":"function","file":"modules/lazy_runner.py","line":1188,"end_line":1245,"language":"py","signature":"def bind_target_authority(shell, targets: list[str]) -> dict","params":[{"name":"shell","annotation":"","default":"","kind":"positional"},{"name":"targets","annotation":"list[str]","default":"","kind":"positional"}],"returns":"dict","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Make the run's target(s) authoritative over payload rhost and scope.","description":"The loop binds a target to the task, but offensive verbs and the scope\nguard read ``rhost`` and ``scope`` from ``payload.json``. When those\nare stale, a run can act against a host the operator never named: a\nverb falls back to a stale ``rhost`` or the planner wanders onto a\nstale but still-in-scope host. This binds ``rhost`` to the primary\ntarget and replaces the authorized scope with exactly the run's\ntargets, so the loop can only touch what was requested. Writes go\nthrough the shell's single payload writer; the enforcement posture is\nleft untouched.","params":[{"name":"shell","type":"","description":"The live LazyOwn shell whose params back the payload.","default":""},{"name":"targets","type":"","description":"The validated run target(s); the first is the primary ``rhost`` and the full list becomes the authorized scope.","default":""}],"returns":{"name":"","type":"","description":"A summary mapping (``bound``, ``rhost``, ``scope``, and the prior\nvalues) or ``{\"bound\": False}`` when there is nothing to bind.","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"modules/lazy_runner.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["core/config.py::save_payload","core/console.py::print_