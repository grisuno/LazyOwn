{"uid":"cli/apt_chain_support.py::resolve_invocation","name":"resolve_invocation","qualname":"resolve_invocation","kind":"function","file":"cli/apt_chain_support.py","line":234,"end_line":319,"language":"py","signature":"def resolve_invocation(positionals: list[str], target_seed: str = '', preset_target: str = '', playbook_engine: Any = None, playbook_seed: str = '', policy: str = 'strict') -> tuple[str, str, str, str]","params":[{"name":"positionals","annotation":"list[str]","default":"","kind":"positional"},{"name":"target_seed","annotation":"str","default":"''","kind":"positional"},{"name":"preset_target","annotation":"str","default":"''","kind":"positional"},{"name":"playbook_engine","annotation":"Any","default":"None","kind":"positional"},{"name":"playbook_seed","annotation":"str","default":"''","kind":"positional"},{"name":"policy","annotation":"str","default":"'strict'","kind":"positional"}],"returns":"tuple[str, str, str, str]","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Classify positional tokens into chain, target and playbook override.","description":"Single classification shared by the ``apt_chain`` CLI command and the\nloop stepwise adapter. Both surfaces share one classification table\n(chain file, target-shaped token, known playbook, ``apt_<name>``\nfallback) while keeping their two codified policies:\n\n- ``strict`` (CLI): a chain must exist as a file; bare tokens are\n  targets when they parse as hosts, playbook names otherwise.\n- ``lenient`` (loop): the first positional is always the chain name\n  unless it is an address and no target is known; later tokens only\n  supply the target (first match wins).","params":[{"name":"positionals","type":"","description":"Free tokens left after flag parsing.","default":""},{"name":"target_seed","type":"","description":"Fallback target (``rhost``); a positional target replaces it when ``--target`` is not preset.","default":""},{"name":"preset_target","type":"","description"