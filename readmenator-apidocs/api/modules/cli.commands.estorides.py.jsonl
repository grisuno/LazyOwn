{"uid":"cli/commands/estorides.py::EstoridesCommandSet.do_estorides_loop","name":"do_estorides_loop","qualname":"EstoridesCommandSet.do_estorides_loop","kind":"method","file":"cli/commands/estorides.py","line":337,"end_line":434,"language":"py","signature":"def do_estorides_loop(self, line: str) -> None","params":[{"name":"line","annotation":"str","default":"","kind":"positional"}],"returns":"None","decorators":["cmd2.with_category(recon_category)"],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Run the bidirectional Estorides <-> LazyOwn feedback loop.","description":"Each iteration:\n  1. Extract seeds from LazyOwn (world model, scope, DB, hosts files)\n  2. Feed each seed into Estorides discover for passive OSINT\n  3. Import new entities back into LazyOwn DB + scope\n  4. New entities become seeds for the next iteration\n  5. Runs lazynmap / nuclei if operator opts in on new targets\n\nThe loop converges when no new assets are discovered or max\niterations is reached.\n\nUsage:\n    estorides_loop [--iter <n>] [--depth <n>] [--auto-scan]\n\nOptions:\n    --iter <n>       Max iterations (default: 3)\n    --depth <n>      Discovery depth per seed (default: 2)\n    --auto-scan      Automatically run lazynmap on new IPs discovered\n                     by Estorides (requires active scanning permission)","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":["estorides_loop                    # 3 iterations, passive only\nestorides_loop --iter 5 --depth 3 # 5 iterations, deeper discovery\nestorides_loop --auto-scan        # auto-scan new IPs from OSINT"],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"cli/commands/estorides.py::EstoridesCommandSet","members":[],"inferred_raises":[],"returns_value":false,"value":"","base_uids":[],"subclasses":[],"calls":["core/console.py::print_msg","modules/estorides_importer.py::FeedbackLoop.__init__","modules/estorides_importer.py::FeedbackLoop.run"],"called_by":[]}
{"uid":"cli/commands/estorides.py::EstoridesCommandSet.do_estorides_surface","name":"do_estorides_surface","qualname":"EstoridesCommandSet.do_estorides_surface","kind":"method","file":"cli/commands/estorides.py","line":441,"end_line":551,"language":"py","signature":"def do_estorides_surface(self, line: str) -> None","params":[{"name":"line","annotation":"str","default":"","kind":"positional"}],"returns":"None","decorators":["cmd2.with_category(recon_category)"],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Show the combined active + passive attack surface.","description":"Aggregates targets from:\n  - LazyOwn database (lazyown.db hosts table)\n  - LazyOwn scope (payload.json)\n  - LazyOwn world model (sessions/world_model.json)\n  - Estorides case store (estorides_cases.sqlite)\n  - Estorides STIX bundles\n\nUsage:\n    estorides_surface [--json] [--export <path>]\n\nOptions:\n    --json          Output as JSON\n    --export <path> Export combined surface to JSON file","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":["estorides_surface\nestorides_surface --json\nestorides_surface --export sessions/combined_surface.json"],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"cli/commands/estorides.py::EstoridesCommandSet","members":[],"inferred_raises":[],"returns_value":false,"value":"","base_uids":[],"subclasses":[],"calls":["core/console.py::print_msg","modules/estorides_importer.py::EstoridesCaseReader.__init__","modules/estorides_importer.py::EstoridesCaseReader.close","modules/estorides_importer.py::EstoridesCaseReader.get_host_entities","modules/estorides_importer.py::EstoridesStixParser.__init__","modules/estorides_importer.py::EstoridesStixParser.parse_by_type","modules/estorides_importer.py::EstoridesToLazyOwnBridge.__init__","modules/estorides_importer.py::EstoridesToLazyOwnBridge.get_combined_surface"],"called_by":[]}
