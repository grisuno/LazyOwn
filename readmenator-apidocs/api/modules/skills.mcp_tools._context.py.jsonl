e permission system or None.","default":""},{"name":"get_hooks","type":"","description":"Return the hooks runner or None.","default":""},{"name":"get_claudemd","type":"","description":"Return the loaded CLAUDE.md hierarchy or None.","default":""},{"name":"job_store","type":"","description":"The shared background-job store singleton, so async-run and job-status tools observe the same jobs.","default":""},{"name":"list_tools","type":"","description":"The server's async ``list_tools`` coroutine, for tools that search or enumerate the whole catalogue.","default":""},{"name":"sitrep_recommendations","type":"","description":"Return the top campaign recommendations, for session-brief tools.","default":""}],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"skills/mcp_tools/_context.py","members":["skills/mcp_tools/_context.py::MCPContext.text","skills/mcp_tools/_context.py::MCPContext.load_payload","skills/mcp_tools/_context.py::MCPContext.save_payload","skills/mcp_tools/_context.py::MCPContext.lazyown_dir","skills/mcp_tools/_context.py::MCPContext.sessions_dir","skills/mcp_tools/_context.py::MCPContext.modules_dir","skills/mcp_tools/_context.py::MCPContext.skills_dir","skills/mcp_tools/_context.py::MCPContext.run_command","skills/mcp_tools/_context.py::MCPContext.c2_request","skills/mcp_tools/_context.py::MCPContext.get_policy","skills/mcp_tools/_context.py::MCPContext.get_transcript","skills/mcp_tools/_context.py::MCPContext.get_perm_system","skills/mcp_tools/_context.py::MCPContext.get_hooks","skills/mcp_tools/_context.py::MCPContext.get_claudemd","skills/mcp_tools/_context.py::MCPContext.job_store","skills/mcp_tools/_context.py::MCPContext.list_tools","skills/mcp_tools/_context.py::MCPContext.sitrep_recommendations"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
