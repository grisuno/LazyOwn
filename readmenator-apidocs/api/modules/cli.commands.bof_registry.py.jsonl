{"uid":"cli/commands/bof_registry.py::BofMarketplaceCommandSet.do_bof_run","name":"do_bof_run","qualname":"BofMarketplaceCommandSet.do_bof_run","kind":"method","file":"cli/commands/bof_registry.py","line":191,"end_line":245,"language":"py","signature":"def do_bof_run(self, line: str)","params":[{"name":"line","annotation":"str","default":"","kind":"positional"}],"returns":"","decorators":["cmd2.with_category(command_and_control_category)"],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Execute a BOF on a connected beacon.","description":"Usage: bof_run <bof_name> <beacon_client_id> [arg1,arg2,...] [--wait <sec>]\n\nStages the BOF, then queues a ``bof:<c2_url>/bof/<name>\n<args>`` command on the C2 for the specified beacon. The beacon\ndownloads the raw base64 object over the malleable channel and\nexecutes it in-process (COFFLoader on Windows, RunELF loader on\nBlackSandBeacon).","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":["bof_run whoami_linux linux_beacon_01 --wait 20"],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"cli/commands/bof_registry.py::BofMarketplaceCommandSet","members":[],"inferred_raises":[],"returns_value":false,"value":"","base_uids":[],"subclasses":[],"calls":["core/console.py::print_error","core/console.py::print_msg","core/console.py::print_succ","modules/bof_delivery.py::run_bof"],"called_by":[]}
{"uid":"cli/commands/bof_registry.py::BofMarketplaceCommandSet.do_bof_train","name":"do_bof_train","qualname":"BofMarketplaceCommandSet.do_bof_train","kind":"method","file":"cli/commands/bof_registry.py","line":248,"end_line":307,"language":"py","signature":"def do_bof_train(self, line: str)","params":[{"name":"line","annotation":"str","default":"","kind":"positional"}],"returns":"","decorators":["cmd2.with_category(command_and_control_category)"],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Run a sequence of BOFs over one beacon, awaiting each result.","description":"Usage: bof_train <beacon_client_id> --bofs <n1,n2,...> [--args <a1,a2>] [--wait <sec>]\n\nOrchestratable single step: the C2 receives one ``bof:`` command\nper BOF and the command aggregates the outputs from the beacon\nhistory into one report.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":["bof_train metasploitable --bofs whoami_linux,is_sudo,suid_enum --wait 20"],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"cli/commands/bof_registry.py::BofMarketplaceCommandSet","members":[],"inferred_raises":[],"returns_value":false,"value":"","base_uids":[],"subclasses":[],"calls":["core/console.py::print_error","core/console.py::print_msg","modules/bof_delivery.py::run_bof_train"],"called_by":[]}
