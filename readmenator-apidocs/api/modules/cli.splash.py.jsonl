{"uid":"cli/splash.py","name":"splash.py","qualname":"cli/splash.py","kind":"module","file":"cli/splash.py","line":1,"end_line":215,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Animated splash overlay for the LazyOwn first-run experience.","description":"The splash is rendered with Rich on top of the existing ASCII art\nbanner. Operators keep their original art: this overlay just paints\na typewriter effect around it during the first 1-2 seconds of\nstartup, then exits cleanly back to the cmd2 prompt. Opt-in via\n``payload.json[\"splash\"] = true`` (default false), and auto-on\nwhen ``payload.json`` does not yet exist.\n\nDesign notes:\n\n- Single Responsibility: only the overlay animation lives here.\n  No payload reading, no shell state, no theme mutation. Callers\n  pass the already-resolved theme tokens.\n- Open/Closed: new animation kinds (e.g. glitch, fade) extend\n  :class:`SplashEffect`; the dispatcher in :func:`render_splash`\n  does not change.\n- Dependency Inversion: callers depend on :func:`render_splash`\n  and the :class:`SplashEffect` protocol, not on Rich directly.\n- No magic numbers: timing constants live in :data:`SPLASH_CONFIG`.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["cli/splash.py::SplashConfig","cli/splash.py::SPLASH_CONFIG","cli/splash.py::SplashEffect","cli/splash.py::TypewriterEffect","cli/splash.py::InstantEffect","cli/splash.py::render_splash"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"cli/splash.py::SplashConfig","name":"SplashConfig","qualname":"SplashConfig","kind":"class","file":"cli/splash.py","line":37,"end_line":55,"language":"py","signature":"class SplashConfig","params":[{"name":"total_seconds","annotation":"float","default":"1.5","kind":"positional"},{"name":"per_char_seconds","annotation":"float","default":"0.012","kind":"positional"},{"name":"clear_after","annotation":"bool","default":"True","kind":"positional"}],"returns":"","decorators":["dataclass(frozen=True)"],"bases":[],"modifiers":["dataclass"],"visibility":"public","doc":{"summary":"Timing and behaviour knobs for the splash overlay.","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[{"name":"total_seconds","type":"","description":"How long the overlay stays on screen. ``0``\nor negative means render-and-exit immediately. The\neffect never blocks longer than this regardless of the\ntypewriter per-character delay.","default":""},{"name":"per_char_seconds","type":"","description":"Delay between consecutive characters in the typewriter effect. Lower values feel snappier.","default":""},{"name":"clear_after","type":"","description":"Whether to clear the overlay before returning\nto the caller. When ``False`` the operator sees the\nsplash frozen at its final state -- useful for\nscreencasts but disruptive in a real shell.","default":""}],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"cli/splash.py","members":["cli/splash.py::SplashConfig.total_seconds","cli/splash.py::SplashConfig.per_char_seconds","cli/splash.py::SplashConfig.clear_after"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
