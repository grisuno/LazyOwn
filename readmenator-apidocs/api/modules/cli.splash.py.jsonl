{"uid":"cli/splash.py::render_splash","name":"render_splash","qualname":"render_splash","kind":"function","file":"cli/splash.py","line":166,"end_line":205,"language":"py","signature":"def render_splash(console: Console, lines: list[str], payload: Mapping[str, object] | None = None, config: SplashConfig | None = None, effect_name: str = 'typewriter') -> None","params":[{"name":"console","annotation":"Console","default":"","kind":"positional"},{"name":"lines","annotation":"list[str]","default":"","kind":"positional"},{"name":"payload","annotation":"Mapping[str, object] | None","default":"None","kind":"positional"},{"name":"config","annotation":"SplashConfig | None","default":"None","kind":"positional"},{"name":"effect_name","annotation":"str","default":"'typewriter'","kind":"positional"}],"returns":"None","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Render the splash overlay and optionally clear the screen.","description":"","params":[{"name":"console","type":"","description":"Rich console the shell already uses. The overlay\nwrites through it so colours and terminal width match\nthe rest of the operator surface.","default":""},{"name":"lines","type":"","description":"Lines to animate. Each entry is a plain string --\nmarkup is intentionally NOT parsed, so the operator's\nASCII art (which often contains brackets) renders\nverbatim.","default":""},{"name":"payload","type":"","description":"Payload mapping for theme resolution. ``None``\nuses the default theme; passing the live payload\nhonours the operator's chosen ``tui_theme``.","default":""},{"name":"config","type":"","description":"Override timing/clear behaviour. ``None`` uses :data:`SPLASH_CONFIG`.","default":""},{"name":"effect_name","type":"","description":"Which effect to dispatch. ``\"typewriter\"``\nor ``\"instant\"``. Unknown values fall back to\n``\"instant\"`` so a bad config never crashes startup.","default":""}],"returns":{"name":"","type":"","description":"None. The console is left in a state ready for the next\nprompt line to be printed (or cleared, depending on\n``config.clear_after``).","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"cli/splash.py","members":[],"inferred_raises":[],"returns_value":false,"value":"","base_uids":[],"subclasses":[],"calls":["cli/style.py::active_tokens"],"called_by":[]}
