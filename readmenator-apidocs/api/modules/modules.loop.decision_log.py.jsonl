{"uid":"modules/loop/decision_log.py::digest","name":"digest","qualname":"digest","kind":"function","file":"modules/loop/decision_log.py","line":51,"end_line":65,"language":"py","signature":"def digest(text: str) -> str","params":[{"name":"text","annotation":"str","default":"","kind":"positional"}],"returns":"str","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Return the stable short digest used to fingerprint a decision input.","description":"","params":[{"name":"text","type":"","description":"Arbitrary input text (a prompt, a reply, a serialised context).","default":""}],"returns":{"name":"","type":"","description":"The first :data:`_DIGEST_WIDTH` hex characters of the SHA-256 of\n``text``; an empty string maps to an empty digest so absence is\ndistinguishable from content.","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"modules/loop/decision_log.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":["modules/loop/decision_log.py::config_digest","modules/loop/decision_log.py::context_digest"]}
{"uid":"modules/loop/decision_log.py::context_digest","name":"context_digest","qualname":"context_digest","kind":"function","file":"modules/loop/decision_log.py","line":90,"end_line":112,"language":"py","signature":"def context_digest(ctx: Any) -> str","params":[{"name":"ctx","annotation":"Any","default":"","kind":"positional"}],"returns":"str","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Fingerprint a selection context independent of field ordering.","description":"The context's ``extra`` mapping is unordered by construction, so a naive\nrepr would make equal states hash differently. This canonicalises every\nfield first, which is what lets a caller memoise a decision by state.","params":[{"name":"ctx","type":"","description":"A ``SelectionContext``-shaped object, or any object exposing the same attributes.","default":""}],"returns":{"name":"","type":"","description":"The short digest of the canonical context, or an empty string when the\nobject exposes no recognisable fields.","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"modules/loop/decision_log.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["modules/loop/decision_log.py::digest"],"called_by":[]}
{"uid":"modules/loop/decision_log.py::config_digest","name":"config_digest","qualname":"config_digest","kind":"function","file":"modules/loop/decision_log.py","line":115,"end_line":134,"language":"py","signature":"def config_digest(config: Mapping[str, Any] | None) -> str","params":[{"name":"config","annotation":"Mapping[str, Any] | None","default":"","kind":"positional"}],"returns":"str","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Fingerprint the config keys that change a decision's reproducibility.","description":"Only the keys in :data:`_CONFIG_KEYS` participate (planner temperature, the\ndeterminism and guard-rule flags, and model selection), so unrelated config\nchurn does not invalidate a replay while a change that alters the decision\ncorrectly does.","params":[{"name":"config","type":"","description":"A payload mapping, or ``None`` when unavailable.","default":""}],"returns":{"name":"","type":"","description":"The short digest of the relevant config subset.","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"modules/loop/decision_log.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["modules/loop/decision_log.py::digest"],"called_by":[]}
