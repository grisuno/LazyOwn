{"uid":"modules/playbook_admin.py","name":"playbook_admin.py","qualname":"modules/playbook_admin.py","kind":"module","file":"modules/playbook_admin.py","line":1,"end_line":444,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Safe CRUD for the YAML playbooks under ``playbooks/``.","description":"Two playbook shapes coexist on disk:\n\n- APT playbooks (``apt_*.yaml``) declare ``apt_name``, ``platforms`` and a\n  ``phases`` list consumed by :mod:`modules.apt_playbooks`;\n- generated plans (``attack_plan*.yaml``) declare ``apt_name`` plus a\n  ``steps`` list consumed by :mod:`modules.playbook_engine`.\n\nThis module is the single writer for both. Every mutation is validated,\nconfined to the playbooks directory and written atomically so the TUI can\nadministrate files without ever leaving a half-written YAML behind.\n\nThe TUI (``lazy_orchestrator``) imports only this module for playbook\nCRUD; readers keep loading YAML themselves.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/playbook_admin.py::PLAYBOOKS_DIR","modules/playbook_admin.py::MAX_PLAYBOOK_BYTES","modules/playbook_admin.py::PlaybookEntry","modules/playbook_admin.py::slugify","modules/playbook_admin.py::playbook_path","modules/playbook_admin.py::load_playbook","modules/playbook_admin.py::playbook_kind","modules/playbook_admin.py::validate_playbook","modules/playbook_admin.py::summarize","modules/playbook_admin.py::scan_playbooks","modules/playbook_admin.py::preview_playbook","modules/playbook_admin.py::playbook_template","modules/playbook_admin.py::create_playbook","modules/playbook_admin.py::update_playbook","modules/playbook_admin.py::save_playbook_yaml","modules/playbook_admin.py::delete_playbook"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"c