{"uid":"modules/chain_match.py","name":"chain_match.py","qualname":"modules/chain_match.py","kind":"module","file":"modules/chain_match.py","line":1,"end_line":196,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Shared selector for the best vetted chain given phase, platform and services.","description":"Both the autonomous daemon's ChainSelector and the LazyLoopEngine planner need\nto answer the same question -- \"which chain under ``chains/`` fits what we have\ndiscovered right now?\" -- so the scoring rules live here once and both callers\ndelegate to :func:`best_chain`. Selection is evidence-based: a chain scores zero\nunless at least one of its tags matches a discovered service, so a chain is never\nproposed blindly. Phase affinity only re-ranks already service-matched chains.\nLab and gym chains are included by default because the framework is heavily\nlab-oriented and most operators run it against ranges; real-engagement\noperators exclude them by passing ``allow_lab=False`` (env\n``AUTO_CHAIN_SELECTOR_LAB=0`` at the call sites).","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/chain_match.py::STRATEGIC_PHASES","modules/chain_match.py::LAB_TAGS","modules/chain_match.py::SERVICE_TAG_ALIASES","modules/chain_match.py::PHASE_AFFINITY","modules/chain_match.py::normalize_tags","modules/chain_match.py::service_tokens","modules/chain_match.py::platform_ok","modules/chain_match.py::score","modules/chain_match.py::reset_cache","modules/chain_match.py::load_rows","modules/chain_match.py::best_chain"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
