{"uid":"cli/commands/estorides.py::EstoridesCommandSet.do_estorides_seed","name":"do_estorides_seed","qualname":"EstoridesCommandSet.do_estorides_seed","kind":"method","file":"cli/commands/estorides.py","line":73,"end_line":182,"language":"py","signature":"def do_estorides_seed(self, line: str) -> None","params":[{"name":"line","annotation":"str","default":"","kind":"positional"}],"returns":"None","decorators":["cmd2.with_category(recon_category)"],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Feed LazyOwn hosts/domains into Estorides for passive OSINT discovery.","description":"Usage:\n    estorides_seed [--source <src>] [--max-depth <n>] [--max-steps <n>]\n\nSeed sources:\n    all          - All available sources (default)\n    world_model  - From sessions/world_model.json\n    hosts_file   - From sessions/hostsdiscovery.txt\n    db           - From lazyown.db hosts table\n    scope        - From payload.json scope list\n    <ip/domain>  - Manual seed value","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":["estorides_seed                          # seed all sources\nestorides_seed --source hosts_file      # only from hostsdiscovery.txt\nestorides_seed --source scope --max-depth 3\nestorides_seed 10.10.14.141             # manual seed"],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"cli/commands/estorides.py::EstoridesCommandSet","members":[],"inferred_raises":[],"returns_value":false,"value":"","base_uids":[],"subclasses":[],"calls":["core/console.py::print_msg","core/console.py::print_warn","modules/estorides_importer.py::extract_seeds_from_db","modules/estorides_importer.py::extract_seeds_from_hosts_file","modules/estorides_importer.py::extract_seeds_from_scope","modules/estorides_importer.py::extract_seeds_from_world_model","modules/estorides_importer.py::run_estorides_discover"],"called_by":[]}
{"uid":"cli/commands/estorides.py::EstoridesCommandSet.do_estorides_import","name":"do_estorides_import","qualname":"EstoridesCommandSet.do_estorides_import","kind":"method","file":"cli/commands/estorides.py","line":189,"end_line":317,"language":"py","signature":"def do_estorides_import(self, line: str) -> None","params":[{"name":"line","annotation":"str","default":"","kind":"positional"}],"returns":"None","decorators":["cmd2.with_category(recon_category)"],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Import Estorides-discovered entities into LazyOwn database and scope.","description":"Usage:\n    estorides_import [--from <source>] [--case-id <id>] [--no-scope] [--no-db]\n\nImport sources:\n    case        - Read from estorides case store (SQLite)\n    stix        - Parse STIX 2.1 bundles from estorides data/\n    lan         - Read Estorides LAN bundle (data/lan_output or\n                  sessions/lan_inventory.json) into DB + scope\n    all         - All available sources (default)\n\nOptions:\n    --from <s>      Source to import from (case, stix, lan, all)\n    --case-id <id>  Import a specific case by ID\n    --no-scope      Do not add discovered assets to payload.json scope\n    --no-db         Do not add discovered assets to lazyown.db\n    --preview       Preview entities only, do not import","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":["estorides_import                          # import all\nestorides_import --from stix              # from STIX bundles\nestorides_import --from case --case-id a1b2c3d4\nestorides_import --preview                # preview only"],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"cli/commands/estorides.py::EstoridesCommandSet","members":[],"inferred_raises":[],"returns_value":false,"value":"","base_uids":[],"subclasses":[],"calls":["core/console.py::print_msg","core/console.py::print_warn","modules/estorides_importer.py::EstoridesCaseReader.