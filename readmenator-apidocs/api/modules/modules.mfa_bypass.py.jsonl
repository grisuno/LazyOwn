p_login', 'pop3_login'], 'mitre': 'T1110.001'}, 'evilginx_reverse': {'name': 'Evilginx Reverse Proxy', 'description': 'Man-in-the-middle phishing proxy that captures session tokens', 'target_protocols': ['SAML', 'OAuth2', 'OIDC'], 'tools': ['evilginx2', 'muraena', 'modlishka'], 'mitre': 'T1566'}, 'device_code': {'name': 'Device Code Phishing', 'description': 'Trick victim into entering device code on legitimate Microsoft login', 'target_protocols': ['OAuth2 Device Code Flow'], 'tools': ['TokenTactics', 'AADInternals'], 'mitre': 'T1528'}, 'conditional_access': {'name': 'Conditional Access Policy Enumeration', 'description': 'Enumerate MFA/CA policies to find gaps (no MFA for certain apps)', 'target_protocols': ['Microsoft Graph API'], 'tools': ['AADInternals', 'GraphRunner'], 'mitre': 'T1082'}, 'sim_swap': {'name': 'SIM Swap Attack', 'description': \"Social engineer mobile carrier to transfer victim's number to attacker SIM\", 'target_protocols': ['SMS', 'Voice'], 'tools': ['social_engineering', 'OSINT'], 'mitre': 'T1598'}, 'adfs_trust': {'name': 'ADFS Trust Relationship Abuse', 'description': 'Abuse ADFS trust to bypass MFA via federated identity', 'target_protocols': ['SAML', 'WS-Fed'], 'tools': ['ADFSDump', 'GoldenSAML'], 'mitre': 'T1606'}}","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
