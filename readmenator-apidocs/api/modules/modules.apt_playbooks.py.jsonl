{"uid":"modules/apt_playbooks.py","name":"apt_playbooks.py","qualname":"modules/apt_playbooks.py","kind":"module","file":"modules/apt_playbooks.py","line":1,"end_line":321,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"APT Playbook Engine — map public APT reports to executable Atomic Red Team chains.","description":"This module reads enriched playbooks from ``playbooks/apt_*.yaml`` and provides\nexecution, validation, and reporting without touching ``lazyown.py`` internals.\n\nPlaybook schema (enriched):\n    apt_name: str\n    aliases: list[str]\n    source_urls: list[str]\n    description: str\n    platforms: list[str]\n    phases:\n      - name: str            # e.g. initial_access, persistence, privilege_escalation\n        technique_id: str     # MITRE ATT&CK technique (e.g. T1566.001)\n        technique_name: str\n        description: str\n        atomic_tests:\n          - atomic_id: str    # ART auto_generated_guid\n            name: str\n            manual: bool      # If true, operator must paste command interactively\n        caldera_abilities:    # Optional CALDERA ability IDs\n          - ability_id: str\n        detection_hints: list[str]","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/apt_playbooks.py::AtomicTestRef","modules/apt_playbooks.py::CalderaAbilityRef","modules/apt_playbooks.py::ACTION_KINDS","modules/apt_playbooks.py::PlaybookAction","modules/apt_playbooks.py::PhaseStep","modules/apt_playbooks.py::AptPlaybook","modules/apt_playbooks.py::AptPlaybookEngine"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
