{"uid":"skills/claude_md_orchestrator/cicd_agent.py","name":"cicd_agent.py","qualname":"skills/claude_md_orchestrator/cicd_agent.py","kind":"module","file":"skills/claude_md_orchestrator/cicd_agent.py","line":1,"end_line":236,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"CI and CD agent.","description":"The agent cuts a feature branch, stages the artifacts, prepares the CI\npipeline, and writes the PR body. The agent never pushes and never\ndeploys. The deploy gate is closed by default. The orchestrator only\nopens the gate when the operator supplies the deploy gate token.\n\nThe pipeline file is a real GitHub Actions workflow. The agent keeps\nthe workflow minimal and explicit. The workflow runs ruff, mypy,\nbandit, and pytest. The workflow fails when any of those return a\nnon zero exit code. The agent does not invent matrix builds or\nrelease pipelines. The skill stays portable across LazyOwn releases.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["skills/claude_md_orchestrator/cicd_agent.py::SAFE_BRANCH","skills/claude_md_orchestrator/cicd_agent.py::PIPELINE_TEMPLATE","skills/claude_md_orchestrator/cicd_agent.py::CicdResult","skills/claude_md_orchestrator/cicd_agent.py::run"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
