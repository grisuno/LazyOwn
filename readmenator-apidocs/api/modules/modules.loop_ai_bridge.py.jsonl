{"uid":"modules/loop_ai_bridge.py","name":"loop_ai_bridge.py","qualname":"modules/loop_ai_bridge.py","kind":"module","file":"modules/loop_ai_bridge.py","line":1,"end_line":521,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Single edge between the autonomous loop and the LazyOwn AI stack.","description":"The loop does not reimplement AI plumbing: this bridge is the one place\nwhere it publishes events to the unified event bus, feeds the episodic\nHive Mind memory, consults the detection oracle, uses the MoE router\nand RL trainer for expert selection and outcome learning, and can ask\nSWAN for an ensemble plan. Every call is guarded and gated by an\norchestrator stage toggle, so disabling a stage (or an unavailable\ndependency) degrades to a no-op instead of breaking the loop.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/loop_ai_bridge.py::publish_loop_event","modules/loop_ai_bridge.py::assess_opsec","modules/loop_ai_bridge.py::intent_tool_class","modules/loop_ai_bridge.py::record_outcome_quality","modules/loop_ai_bridge.py::tool_class_yields","modules/loop_ai_bridge.py::annotate_detection","modules/loop_ai_bridge.py::moe_route","modules/loop_ai_bridge.py::moe_record_outcome","modules/loop_ai_bridge.py::rl_select","modules/loop_ai_bridge.py::rl_update","modules/loop_ai_bridge.py::rl_save","modules/loop_ai_bridge.py::record_step","modules/loop_ai_bridge.py::swan_available","modules/loop_ai_bridge.py::swan_consult","modules/loop_ai_bridge.py::ai_snapshot"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
