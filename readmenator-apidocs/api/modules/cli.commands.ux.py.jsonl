{"uid":"cli/commands/ux.py::UxCommandSet.do_hud","name":"do_hud","qualname":"UxCommandSet.do_hud","kind":"method","file":"cli/commands/ux.py","line":46,"end_line":82,"language":"py","signature":"def do_hud(self, line)","params":[{"name":"line","annotation":"","default":"","kind":"positional"}],"returns":"","decorators":["cmd2.with_category('12. Miscellaneous')"],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Session counters: elapsed time, commands run, material captured.","description":"Complements rather than repeats the other commands. ``killchain``\nowns the kill-chain phases, the status bar already shows target and\nphase, and ``sitrep`` owns the full picture. This shows only what\nnothing else reports: how long this session has run, how many\ncommands it executed, and how many credentials and notes exist.\n\nUsage:\n    ``hud``          — two counter lines\n    ``hud --json``   — machine-readable JSON without ANSI\n    ``hud --plain``  — plain text without colours","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"cli/commands/ux.py::UxCommandSet","members":[],"inferred_raises":[],"returns_value":false,"value":"","base_uids":[],"subclasses":[],"calls":["cli/output_mode.py::format_output","cli/output_mode.py::parse_output_flags","cli/session_hud.py::build_snapshot","cli/session_hud.py::render_snapshot","core/console.py::print_msg"],"called_by":[]}
