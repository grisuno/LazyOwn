{"uid":"core/api_authz.py::require_api_auth","name":"require_api_auth","qualname":"require_api_auth","kind":"function","file":"core/api_authz.py","line":365,"end_line":434,"language":"py","signature":"def require_api_auth(store: ApiKeyStore, permissions: frozenset[str] | None = None, require_tenant: bool | None = None)","params":[{"name":"store","annotation":"ApiKeyStore","default":"","kind":"positional"},{"name":"permissions","annotation":"frozenset[str] | None","default":"None","kind":"positional"},{"name":"require_tenant","annotation":"bool | None","default":"None","kind":"positional"}],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Flask-route decorator that enforces API-key + tenant authorization.","description":"The API key is extracted from (in priority order):\n1. ``Authorization: Bearer <key>`` header\n2. ``X-API-Key`` header\n3. ``api_key`` query parameter\n\nIf *permissions* is provided the key must hold every listed permission.\nIf *require_tenant* is ``True`` the key must be scoped to a valid\ntenant; when omitted it defaults to\n:data:`ApiAuthzConfig.require_tenant_scope` so the security posture\nlives in one place.\n\nOn failure the decorated route returns a JSON body with ``401`` or\n``403`` — never an HTML error page and never ``abort()``, so the\ncontract holds even in apps with ``TRAP_HTTP_EXCEPTIONS`` enabled.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"core/api_authz.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["static/js/quill-2.0.3.js::Ct.G.I.J.L.M.N.N.Ot.Q.R.S.S.St.T.X.Y.Z.a.b.c.c.d.et.extends.extends.extends.extends.extends.extends.extends.extends.extends.extends.extends.f"],"called_by":["lazyc2/blueprints/api.py::require_api_auth_with_store"]}
