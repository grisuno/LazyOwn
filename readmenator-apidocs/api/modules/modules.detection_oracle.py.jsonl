{"uid":"modules/detection_oracle.py::DetectionOracle","name":"DetectionOracle","qualname":"DetectionOracle","kind":"class","file":"modules/detection_oracle.py","line":317,"end_line":468,"language":"py","signature":"class DetectionOracle(IDetectionOracle)","params":[],"returns":"","decorators":[],"bases":["IDetectionOracle"],"modifiers":[],"visibility":"public","doc":{"summary":"Maps a (command, args, action_category) triple to a detection probability.","description":"Matching algorithm\n------------------\n1. Scan all sigma rules for keyword hits in the lowercased command+args.\n2. Include rules whose category_tags overlap with action_category.\n3. Boost matched rule probabilities by 10% when both keyword AND category hit.\n4. Aggregate using the OR-probability formula:\n       P = 1 - prod(1 - effective_p_i)\n5. Clamp result to [0.0, 1.0].\n6. Fall back to _CATEGORY_BASE_PROBABILITY when no rules matched.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"modules/detection_oracle.py","members":["modules/detection_oracle.py::DetectionOracle.__init__","modules/detection_oracle.py::DetectionOracle.refresh","modules/detection_oracle.py::DetectionOracle.assess","modules/detection_oracle.py::DetectionOracle.probability"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":["modules/detection_oracle.py::IDetectionOracle"],"subclasses":[],"calls":[],"called_by":[]}
