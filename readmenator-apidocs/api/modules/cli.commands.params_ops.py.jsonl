{"uid":"cli/commands/params_ops.py","name":"params_ops.py","qualname":"cli/commands/params_ops.py","kind":"module","file":"cli/commands/params_ops.py","line":1,"end_line":197,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Operator administration of the shared parameter catalog.","description":"Parameters are the tokens every LazyOwn surface can substitute: addon\ntemplates (``{param}``), aliases, pipelines and the shell ``assign``\ncommand. This set is the non-TUI half of the parameter administrator; the\n``lazy_orchestrator`` console (Params tab) is the visual half. Both call\nthe same registry (:mod:`core.param_registry`), so a parameter declared in\neither place is immediately reusable everywhere.\n\nThe registry stores the declarations as data in ``params/operator.yaml``,\nso creating a parameter needs no source edit: the payload schema and the\naddon creator pick the new key up automatically.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["cli/commands/params_ops.py::ParamCommandSet"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
