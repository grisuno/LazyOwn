annotation":"int","default":"MEAN_INTERVAL","kind":"positional"},{"name":"session_tips","annotation":"Sequence[str]","default":"field(default_factory=list)","kind":"positional"},{"name":"tips_registry","annotation":"Sequence[dict[str, Any]]","default":"field(default_factory=list)","kind":"positional"},{"name":"enabled","annotation":"bool","default":"True","kind":"positional"},{"name":"killchain_auto_every","annotation":"int","default":"0","kind":"positional"},{"name":"killchain_auto_on_phase_change","annotation":"bool","default":"True","kind":"positional"},{"name":"chain_active","annotation":"bool","default":"False","kind":"positional"},{"name":"hints_level","annotation":"str","default":"DEFAULT_UI_HINTS","kind":"positional"},{"name":"killchain_display","annotation":"Callable[[], None] | None","default":"None","kind":"positional"}],"returns":"","decorators":["dataclass"],"bases":[],"modifiers":["dataclass"],"visibility":"public","doc":{"summary":"Centralised configuration for the unified tips engine.","description":"Every magic number, path, and lookup table lives here so the engine\nis testable without touching the filesystem and tunable without\nediting the engine itself.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"cli/tips_engine.py","members":["cli/tips_engine.py::TipsConfig.sessions_dir","cli/tips_engine.py::TipsConfig.command_index_path","cli/tips_engine.py::TipsConfig.users_path","cli/tips_engine.py::TipsConfig.payload_path","cli/tips_engine.py::TipsConfig.hints_limit","cli/tips_engine.py::TipsConfig.tip_limit","cli/tips_engine.py::TipsConfig.evidence_hints","cli/tips_engine.py::TipsConfig.kill_chain_next","cli/tips_engine.py::TipsConfig.phase_priority","cli/tips_engine.py::TipsConfig.high_value_cmds","cli/tips_engine.py::TipsConfig.phase_bonus","cli/tips_engine.py::TipsConfig.vri_rewards","cli/tips_engine.py::TipsConfig.hidden_features","cli