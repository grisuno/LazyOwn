ach leg.","default":""},{"name":"api_key","type":"","description":"Explicit Groq key published to the environment for the ``groq:`` legs; empty resolves the key from ``payload.json``.","default":""},{"name":"members","type":"","description":"Optional chain override (tests, per-task chains).","default":""},{"name":"executor","type":"","description":"Optional leg executor override; defaults to the ``modules.llm_factory`` spec executor.","default":""},{"name":"health","type":"","description":"Optional breaker registry override; defaults to the shared ``modules.llm_pool`` registry.","default":""},{"name":"record","type":"","description":"When True, append outcomes to the pool usage ledger.","default":""}],"returns":{"name":"","type":"","description":"An :class:`OrchestratorResult`; ``ok`` is False with the help\nmessage in ``text`` when every member failed.","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"modules/llm_orchestrator.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["modules/llm_orchestrator.py::OrchestratorResult","modules/llm_orchestrator.py::backend_kind","modules/llm_orchestrator.py::pool_chain","modules/llm_orchestrator.py::sort_members"],"called_by":["lazyc2.py::analyze_behavioral_data","lazyc2.py::analyze_campaign_progress","modules/ai_fallback.py::call","modules/llm_adapter.py::ask_general"]}
