{"uid":"modules/lazy_runner.py::build_executor","name":"build_executor","qualname":"build_executor","kind":"function","file":"modules/lazy_runner.py","line":349,"end_line":431,"language":"py","signature":"def build_executor(shell, config: LoopRunConfig, stream: Callable[[str], None], cancelled: dict, sandbox_task_id: str = '', sandbox_image: str = '', audit=None) -> Callable[[str], str]","params":[{"name":"shell","annotation":"","default":"","kind":"positional"},{"name":"config","annotation":"LoopRunConfig","default":"","kind":"positional"},{"name":"stream","annotation":"Callable[[str], None]","default":"","kind":"positional"},{"name":"cancelled","annotation":"dict","default":"","kind":"positional"},{"name":"sandbox_task_id","annotation":"str","default":"''","kind":"positional"},{"name":"sandbox_image","annotation":"str","default":"''","kind":"positional"},{"name":"audit","annotation":"","default":"None","kind":"positional"}],"returns":"Callable[[str], str]","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Build the worker executor: shell verbs, custom tools, safe bash.","description":"Every branch is stdin-detached: shell verbs cannot prompt (input is\nsuppressed by the autonomous context), custom tools run through the\nstreaming runner, and raw bash goes through ``execute_streaming``\nwith ``stdin=DEVNULL`` and its own process group so Ctrl+C and time\nlimits always kill the child, never the operator's terminal.\n\nSudo availability is gated once, in worker gating\n(``modules.loop.worker_gating``), before a command reaches this\nexecutor — so the probe never runs twice per command.\n\nWhen ``sandbox_task_id`` is set, routable shell verbs run inside the\nper-task Docker container (``modules.lazy_sandbox``) instead of the\noperator host; custom tools and raw bash stay local.\n\nWhen ``audit`` is provided, every dispatched command is recorded in\nthe loop audit timeline with its duration and outcome.","params":[],"returns":null,"yield