{"uid":"cli/commands/active_directory.py::ActiveDirectoryCommandSet.do_kerberos_ticket","name":"do_kerberos_ticket","qualname":"ActiveDirectoryCommandSet.do_kerberos_ticket","kind":"method","file":"cli/commands/active_directory.py","line":24,"end_line":137,"language":"py","signature":"def do_kerberos_ticket(self, line: str) -> None","params":[{"name":"line","annotation":"str","default":"","kind":"positional"}],"returns":"None","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Forge Kerberos tickets for persistence and lateral movement.","description":"Usage: kerberos_ticket <type> [options]\n\nTypes:\n    silver  — Forge a service ticket (needs service account hash)\n    golden  — Forge a TGT (needs krbtgt hash)\n    diamond — Golden ticket + enhanced PAC with admin group SIDs\n    sapphire — S4U2self-based ticket via RBCD\n\nSilver ticket options:\n    --spn <SPN> --domain <DOMAIN> --sid <DOMAIN_SID> --hash <NT_HASH> [--user <user>] [--rid <500>]\n\nGolden ticket options:\n    --domain <DOMAIN> --sid <DOMAIN_SID> --hash <KRBTGT_NT_HASH> [--user <user>] [--groups <513,512,520,518,519>]","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":["kerberos_ticket silver --spn cifs/DC01.domain.local --domain domain.local --sid S-1-5-21-... --hash NT_HASH\nkerberos_ticket golden --domain domain.local --sid S-1-5-21-... --hash KRBTGT_HASH\nkerberos_ticket diamond --domain domain.local --sid S-1-5-21-... --hash KRBTGT_HASH --groups 512,519"],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"cli/commands/active_directory.py::ActiveDirectoryCommandSet","members":[],"inferred_raises":[],"returns_value":false,"value":"","base_uids":[],"subclasses":[],"calls":["modules/kerberos_tickets.py::DiamondTicketConfig","modules/kerberos_tickets.py::DiamondTicketForger.__init__","modules/kerberos_tickets.py::DiamondTicketForger.forge","modules/kerberos_tickets.py::GoldenTicketConfig","modules/kerberos_tickets.py::GoldenTicketForger.__init__","modules/kerberos_tickets.py::GoldenTicketForger.forge","modules/kerberos_tickets.py::SilverTicketConfig","modules/kerberos_tickets.py::SilverTicketForger.__init__","modules/kerberos_tickets.py::SilverTicketForger.forge"],"called_by":[]}
