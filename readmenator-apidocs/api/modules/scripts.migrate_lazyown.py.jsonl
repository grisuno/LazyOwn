{"uid":"scripts/migrate_lazyown.py","name":"migrate_lazyown.py","qualname":"scripts/migrate_lazyown.py","kind":"module","file":"scripts/migrate_lazyown.py","line":1,"end_line":239,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Staged migration script: extract do_* methods from lazyown.py into cli/commands/.","description":"Usage:\n    python3 scripts/migrate_lazyown.py\n\nWhat it does:\n1. Parses lazyown.py with the ast module.\n2. Groups every ``do_*`` method by its ``@cmd2.with_category(...)`` decorator.\n3. For methods that reference module-level globals (api_key, rhost, …) it\n   rewrites those references to ``self.params[...]``.\n4. Writes a ``cli/commands/<phase>.py`` file per category that does NOT\n   already exist.\n5. Prints a diff-ready report so the operator can review before deleting\n   the originals from ``lazyown.py``.\n\nThis script is **read-only** — it never edits ``lazyown.py``.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["scripts/migrate_lazyown.py::LAZYOWN_PATH","scripts/migrate_lazyown.py::OUTPUT_DIR","scripts/migrate_lazyown.py::MODULE_GLOBALS","scripts/migrate_lazyown.py::CATEGORY_TO_PHASE","scripts/migrate_lazyown.py::extract_method","scripts/migrate_lazyown.py::rewrite_globals","scripts/migrate_lazyown.py::build_migrated_module","scripts/migrate_lazyown.py::main"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
