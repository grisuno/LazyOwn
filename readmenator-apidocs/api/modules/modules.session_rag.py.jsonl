{"uid":"modules/session_rag.py","name":"session_rag.py","qualname":"modules/session_rag.py","kind":"module","file":"modules/session_rag.py","line":1,"end_line":575,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"session_rag.py — ChromaDB-backed RAG over sessions/ artefacts.","description":"Incrementally indexes every text artefact in sessions/:\n  *.log, *.txt, *.csv, *.xml, *.json, *.nmap, *.md\n\nState tracked in sessions/rag_state.json (mtime per file) so only\nnew or changed files are re-indexed on each call.\n\nChromaDB is optional — if not installed the module degrades gracefully\nto keyword search (Python in-memory fallback).\n\nInstall:\n    pip install chromadb\n\nPublic API\n----------\nget_rag() -> SessionRAG          singleton\nSessionRAG.index_new()           incremental re-index (fast, cron-safe)\nSessionRAG.index_all()           full re-index from scratch\nSessionRAG.query(text, n)        semantic / keyword search\nSessionRAG.context_for_step(phase, target, n)  -> str for prompt injection\nSessionRAG.stats()               -> dict","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/session_rag.py::SESSIONS_DIR","modules/session_rag.py::RAG_STATE_FILE","modules/session_rag.py::FALLBACK_INDEX_FILE","modules/session_rag.py::CHROMA_DIR","modules/session_rag.py::CHROMA_VERSION_FILE","modules/session_rag.py::COLLECTIONS","modules/session_rag.py::CHUNK_SIZE","modules/session_rag.py::CHUNK_OVERLAP","modules/session_rag.py::MAX_FALLBACK_DOCS","modules/session_rag.py::INDEXABLE_SUFFIXES","modules/session_rag.py::SKIP_PATTERNS","modules/session_rag.py::SessionRAG","modules/session_rag.py::get_rag"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
