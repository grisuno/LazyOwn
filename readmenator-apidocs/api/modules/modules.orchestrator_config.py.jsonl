{"uid":"modules/orchestrator_config.py","name":"orchestrator_config.py","qualname":"modules/orchestrator_config.py","kind":"module","file":"modules/orchestrator_config.py","line":1,"end_line":334,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Operator configuration for the loop core: pipeline stages and auto verbs.","description":"Single source of truth for *what the orchestrator fires* and *which auto\nverbs it may propose or execute*. Defaults live here; operator overrides\npersist under ``payload.json`` -> ``orchestrator`` so the TUI, the engine\nand the registry always read the same merged view.\n\nLayout of the payload section::\n\n    {\n      \"orchestrator\": {\n        \"stages\": {\"compact\": {\"enabled\": false}},\n        \"auto_verbs\": {\n          \"automsf\": {\"enabled\": false},\n          \"myscan\": {\"enabled\": true, \"keywords\": [\"myscan\"],\n                     \"needs_target\": true, \"description\": \"custom verb\"}\n        }\n      }\n    }","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/orchestrator_config.py::STAGE_DEFS","modules/orchestrator_config.py::DEFAULT_STAGES","modules/orchestrator_config.py::stages","modules/orchestrator_config.py::stage_enabled","modules/orchestrator_config.py::set_stage","modules/orchestrator_config.py::effective_verbs","modules/orchestrator_config.py::verb_config","modules/orchestrator_config.py::verb_enabled","modules/orchestrator_config.py::upsert_verb","modules/orchestrator_config.py::remove_verb","modules/orchestrator_config.py::reset"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"modules/orchestrator_config.py::STAGE_DEFS","name":"STAGE_DEFS","qualname":"STAGE_DEFS","kind":"constant","file":"modules/orchestrator_config.py","line":27,"end_line":66,"language":"py","signature":"STAGE_DEFS","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"modules/orchestrator_config.py","members":[],"inferred_raises":[],"returns_value":null,"value":"(('enrich', 'Asset enrichment (DNS/HTTP)', 'every round: first 2 untested scoped assets, 300s cooldown per asset'), ('scheduler', 'TriggerStore / scheduler due()', 'every round: interval, service, task_create, timeout events'), ('planner', 'Planner wake (heuristics + LLM)', 'every round unless paused, expired or over budget'), ('workers', 'Frontier claim + worker execution', 'every round while open intents exist (up to --workers)'), ('traffic_ingest', 'Recorder proxy ingest', 'every round while proxy autostart is enabled'), ('retest', 'Auto retest pending findings', 'every round, up to 3 findings per round'), ('reporter', 'Apply background reporter drafts', 'every round when a finished draft is ready'), ('compact', 'Cold-graph compaction round stamps', 'every planner round; triggers by thresholds and cooldown'), ('intel_sync', 'Fuse into world model / objectives', 'throttled 15s per round; forced on terminal status'), ('wrapup', 'Final planner round + settlement summary', 'on exhausted or timeout status'), ('archive', 'Task and traffic archive snapshot', 'on terminal status (done, exhausted, timeout)'), ('report', 'Findings report export', 'on terminal status when findings exist'), ('notify', 'Channel notifications (finding, task_status)', 'on finding creation and terminal status'), ('ai_bus', 'Publish loop events to the unified event bus and Hive Mind', 'every activity line except raw stream kinds (tool/result/llm)'), ('detection_oracle', 'Annotate commands with detection probability', 'before every executed command; writes oracle risk into the traffic log'), ('rl_feedback', 'MoE router and RL trainer outcome learning', 'after each LLM reply, each executed command, and at terminal'), ('swan_ensemble', 'SWAN ensemble planning (disabled by default)', 'planner LLM step when enabled and SWAN experts are available'), ('llm_stream', 'Stream model deltas into the activity log', 'every pool and agent LLM call while the backend supports streaming'))","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
