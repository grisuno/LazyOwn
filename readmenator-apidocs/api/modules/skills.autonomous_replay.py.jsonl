{"uid":"skills/autonomous_replay.py","name":"autonomous_replay.py","qualname":"skills/autonomous_replay.py","kind":"module","file":"skills/autonomous_replay.py","line":1,"end_line":515,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Deterministic replay of past autonomous-daemon runs.","description":"The autonomous daemon (``skills/autonomous_daemon.py``) emits structured\nevents to ``sessions/autonomous_events.jsonl``. This module reads that\nlog back and reproduces the recorded decision sequence in two flavours:\n\n* ``trace`` — pure analysis, no command is re-executed. The recorded\n  decisions are validated against the deterministic\n  ``decision_seed`` stored with each ``STEP_START`` event, surfacing\n  any divergence (for example a selector chain that was edited\n  between the original run and the replay attempt).\n* ``execute`` — same sequence, but each recorded command is rerun\n  through the existing :class:`ICommandRunner` chain so the operator\n  can compare current output against the recorded snippet. The\n  runner chain is **the same** the live daemon uses, so the harness\n  layers (permissions, hooks) still apply.\n\nReplay never bypasses the operator approval flow; it stops at the same\ncheckpoints the live daemon would.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["skills/autonomous_replay.py::REPLAY_MODE_TRACE","skills/autonomous_replay.py::REPLAY_MODE_EXECUTE","skills/autonomous_replay.py::SUPPORTED_REPLAY_MODES","skills/autonomous_replay.py::STEP_START_TYPE","skills/autonomous_replay.py::STEP_DONE_TYPE","skills/autonomous_replay.py::OUTPUT_SNIPPET_LIMIT","skills/autonomous_replay.py::LAZYOWN_DIR","skills/autonomous_replay.py::SESSIONS_DIR","skills/autonomous_replay.py::DEFAULT_EVENTS_FILE","skills/autonomous_replay.py::ReplayStep","skills/autonomous_replay.py::ReplayDivergence","skills/autonomous_replay.py::ReplayReport","skills/autonomous_replay.py::EventLogReader","skills/autonomous_replay.py::ReplayDispatcher","skills/autonomous_replay.py::replay"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
