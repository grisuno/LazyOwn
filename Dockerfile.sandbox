# LazyOwn Sandbox Dockerfile
# Usage: docker build -f Dockerfile.sandbox -t lazyown-sandbox .
#        docker run -it --rm -v "$(pwd):/app" -w /app lazyown-sandbox [args...]

FROM debian:stable-slim
ENV DEBIAN_FRONTEND=noninteractive

# System dependencies required by LazyOwn
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    nmap \
    masscan \
    hydra \
    john \
    hashcat \
    gobuster \
    dirb \
    sqlmap \
    smbclient \
    smbmap \
    nbtscan \
    onesixtyone \
    snmp \
    whois \
    wget \
    tmux \
    jq \
    golang-go \
    git \
    curl \
    ca-certificates \
    gcc \
    mingw-w64 \
    upx-ucl \
    libcurl4-openssl-dev \
    libssl-dev \
    libffi-dev \
    netcat-traditional \
    dnsutils \
    iputils-ping \
    iproute2 \
    net-tools \
    tcpdump \
    openssl \
    ssh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Isolated virtualenv on PATH so python3 resolves to it, avoiding the
# PEP 668 externally-managed-environment conflict of --break-system-packages.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --upgrade pip setuptools wheel

# Install the light profile (shell + C2 core, no analytics/ML stack) with
# errors surfaced. Add requirements.txt for the full ML/AI stack if needed.
COPY requirements-light.txt ./
RUN pip install --retries 5 --timeout 120 -r requirements-light.txt

# Default entrypoint delegates to lazyown.py
ENTRYPOINT ["python3", "-W", "ignore", "lazyown.py"]
