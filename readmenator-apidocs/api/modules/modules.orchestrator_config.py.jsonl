xcept raw stream kinds'), ('detection_oracle', 'Annotate commands with detection probability', 'before every executed command'), ('rl_feedback', 'MoE router and RL trainer outcome learning', 'after each LLM reply, command and at terminal'), ('swan_ensemble', 'SWAN ensemble planning (disabled by default)', 'planner LLM step when enabled'), ('llm_stream', 'Stream model deltas into the activity log', 'every pool and agent LLM call while supported'))","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
