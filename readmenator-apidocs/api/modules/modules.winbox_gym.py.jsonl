{"uid":"modules/winbox_gym.py","name":"winbox_gym.py","qualname":"modules/winbox_gym.py","kind":"module","file":"modules/winbox_gym.py","line":1,"end_line":752,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"WinBox gym catalogue and control-plane bridge.","description":"WinBox (https://github.com/totekuh/winbox) turns a headless Windows VM\n(Server Core 2022/2025, Windows 11 or Windows 10) into an isolated\nvulnerability-research lab controlled from the operator host. This module\nmirrors :mod:`modules.metasploitable_gym` for the gym catalogue (index\nplaybook, exploit specs, chains) and adds a safe subprocess adapter for\nthe ``winbox`` CLI so the shell command, the gym matrix runner, the\nautonomous loop and the MCP surface share one control plane.\n\nThe lab is dual-use and confined by design: the adapter only drives the\noperator's own WinBox lab VM (libvirt domain managed by the winbox CLI)\nand refuses to run when the binary is missing, falling back to\nguidance-only readiness reporting like :mod:`modules.exploitgym_gym`.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/winbox_gym.py::INDEX_PATH","modules/winbox_gym.py::EXPLOITS_DIR","modules/winbox_gym.py::CHAINS_DIR","modules/winbox_gym.py::REPO_URL","modules/winbox_gym.py::DEFAULT_GUEST_OS","modules/winbox_gym.py::GUEST_OS_OPTIONS","modules/winbox_gym.py::BUILD_TIMEOUT_SEC","modules/winbox_gym.py::APT_PACKAGES_FOR","modules/winbox_gym.py::ALLOWED_ACTIONS","modules/winbox_gym.py::load_index","modules/winbox_gym.py::vulnerabilities","modules/winbox_gym.py::get","modules/winbox_gym.py::chain_for","modules/winbox_gym.py::exploit_for","modules/winbox_gym.py::validate_matrix","modules/winbox_gym.py::summary","modules/winbox_gym.py::binary_path","modules/winbox_gym.py::ensure_installed","modu