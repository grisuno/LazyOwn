{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.8:27b-c16k",
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.8:27b": {
          "name": "qwen3.8:27b"
        },
        "qwen3.8:27b-c16k": {
          "name": "qwen3.8:27b-c16k"
        }
      }
    }
  },
  "mcp": {
    "lazyown": {
      "type": "local",
      "command": ["python3", "{env:LAZYOWN_DIR}/skills/lazyown_mcp_opencode.py"],
      "environment": {
        "LAZYOWN_DIR": "{env:LAZYOWN_DIR}"
      },
      "enabled": true,
      "timeout": 180000
    },
    "minios": {
      "enabled": false
    }
  },
  "experimental": {
    "mcp_timeout": 180000
  }
}
