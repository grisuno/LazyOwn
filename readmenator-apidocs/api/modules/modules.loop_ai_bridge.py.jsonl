{"uid":"modules/loop_ai_bridge.py::assess_opsec","name":"assess_opsec","qualname":"assess_opsec","kind":"function","file":"modules/loop_ai_bridge.py","line":125,"end_line":162,"language":"py","signature":"def assess_opsec(command: str, rhost: str = '') -> dict | None","params":[{"name":"command","annotation":"str","default":"","kind":"positional"},{"name":"rhost","annotation":"str","default":"''","kind":"positional"}],"returns":"dict | None","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Return a pre-execution OPSEC gate assessment, or None when unavailable.","description":"Wraps :class:`modules.opsec_scorer.OpsecScorerV2` with a fresh context\nper call, so the autonomous loop gates noisy commands (allow / warn /\nconfirm / block) the same way ``detection_oracle`` annotates sigma-rule\nmatches, without the two systems' thresholds colliding. Evasion state\nis read from ``payload.json`` so a caller never has to thread it\nthrough the worker.","params":[{"name":"command","type":"","description":"Shell command line about to be executed.","default":""},{"name":"rhost","type":"","description":"Target host, used for sensitivity context.","default":""}],"returns":{"name":"","type":"","description":"Mapping with ``gate``, ``noise``, ``risk_label``, ``explanation``\nand ``mitigations``, or None when the stage is off or scoring\nfailed.","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"modules/loop_ai_bridge.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["core/config.py::load_payload","modules/opsec_scorer.py::OpsecContext","modules/opsec_scorer.py::OpsecScorerV2.__init__","modules/opsec_scorer.py::OpsecScorerV2.assess"],"called_by":[]}
{"uid":"modules/loop_ai_bridge.py::intent_tool_class","name":"intent_tool_class","qualname":"intent_tool_class","kind":"function","file":"modules/loop_ai_bridge.py","line":169,"end_line":210,"language":"py","signature":"def intent_tool_class(summary: str) -> str","params":[{"name":"summary","annotation":"str","default":"","kind":"positional"}],"returns":"str","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Return the coarse tool class an intent summary belongs to.","description":"This is the shared vocabulary that makes the decision-quality reward a\nclosed loop: the planner ranks candidate summaries, and the worker\nrewards the *same* class derived from the intent it finished, so what\nthe trainer learns is exactly what the planner later queries. Keying\non the summary (known at planning time) rather than the eventual\ncommand token (known only after execution) is what lets the two sides\nline up.","params":[{"name":"summary","type":"","description":"Intent summary text as the planner emits it.","default":""}],"returns":{"name":"","type":"","description":"A stable lower-case class key, or an empty string for empty input.","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"modules/loop_ai_bridge.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":["modules/loop_ai_bridge.py::record_outcome_quality","modules/loop_ai_bridge.py::tool_class_yields"]}
{"uid":"modules/loop_ai_bridge.py::record_outcome_quality","name":"record_outcome_quality","qualname":"record_outcome_quality","kind":"function","file":"modules/loop_ai_bridge.py","line":213,"end_line":237,"language":"py","signature":"def record_outcome_quality(worker: str, intent_summary: str, facts: int, findings: int) -> None","params":[{"name":"worker","annotation":"str","default":"","kind":"positional"},{"name":"intent_summary","annotation":"str","default":"","kind":"positional"},{"name":"facts","annotation":"int","default":"","kind":"positional"},{"name":"findings","annotation":"int","default":"","kind":"positional"}],"returns":"None","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Feed one intent's net yield back to MoE/RL as a decision-quality reward.","description":"``record_step`` rewards whether a single command executed without\nfailure; it says nothing about whether the exploration intent it\nbelonged to actually produced intel. This reward closes that gap: a\nconfirmed finding scores highest (1.0), a recorded fact scores partial\ncredit (0.5), and an intent that settled with nothing persisted scores\nzero. The action key is the intent's tool class (see\n:func:`intent_tool_class`), the same key :func:`tool_class_yields`\nreads back, so the planner can demote classes that have stopped\nproducing intel for this engagement.","params":[{"name":"worker","type":"","description":"Emitting worker name.","default":""},{"name":"intent_summary","type":"","description":"Summary of the finished intent.","default":""},{"name":"facts","type":"","description":"Facts persisted by the intent's writeback.","default":""},{"name":"findings","type":"","description":"Findings persisted by the intent's writeback.","default":""}],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"modules/loop_ai_bridge.py","members":[],"inferred_raises":[],"returns_value":false,"value":"","base_uids":[],"subclasses":[],"calls":["modules/loop_ai_bridge.py::intent_tool_class","modules/loop_ai_bridge.py::moe_record_outcome","modules/loop_ai_bridge.py::rl_update"],"called_by":[]}
{"uid":"modules/loop_ai_bridge.py::tool_class_yields","name":"tool_class_yields","qualname":"tool_class_yields","kind":"function","file":"modules/loop_ai_bridge.py","line":240,"end_line":277,"language":"py","signature":"def tool_class_yields(summaries: list[str], phase: str = DECISION_PHASE) -> dict[str, float]","params":[{"name":"summaries","annotation":"list[str]","default":"","kind":"positional"},{"name":"phase","annotation":"str","default":"DECISION_PHASE","kind":"positional"}],"returns":"dict[str, float]","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Return the learned decision-quality yield for each candidate summary.","description":"Consumer side of the decision-quality reward: maps each summary to its\n:func:`intent_tool_class` and returns the trainer's current Q-value for\nthat class. Unseen classes come back at the optimistic init (``1.0``),\nclasses that kept producing intel climb above it, and classes that\nstopped producing decay below it, so the planner can rank on the gap.","params":[{"name":"summaries","type":"","description":"Candidate summaries the planner is about to rank.","default":""},{"name":"phase","type":"","description":"Engagement phase key the reward was recorded under.","default":""}],"returns":{"name":"","type":"","description":"Mapping of summary to its class Q-value; empty when the stage is\noff, the trainer is unavailable, or no summary maps to a class.","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"modules/loop_ai_bridge.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["modules/loop_ai_bridge.py::intent_tool_class","modules/rl_trainer.py::get_trainer"],"called_by":[]}
