{"uid":"modules/phishing_orchestrator.py","name":"phishing_orchestrator.py","qualname":"modules/phishing_orchestrator.py","kind":"module","file":"modules/phishing_orchestrator.py","line":1,"end_line":908,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Smart Phishing Campaign Orchestrator.","description":"Provides a ``PhishingOrchestrator`` that automates the full phishing lifecycle:\ntarget profiling, email template generation, landing page cloning, credential\nharvesting, and campaign analytics. Integrates with the C2 infrastructure\nfor callback tracking.\n\nArchitecture:\n    TargetProfiler -> TemplateGenerator -> CampaignLauncher -> CredentialHarvester -> Analyst\n\nSupported modes:\n    credential_harvest  — Clone login pages and collect credentials.\n    payload_delivery    — Send weaponized attachments.\n    callback_beacon     — Embed C2 callback URLs for initial access.\n    mfa_bombing        — Push notification fatigue attacks.\n\nSecurity:\n    All harvested credentials are written to ``sessions/phishing_creds.json``.\n    Campaign data is isolated per engagement. No target email addresses are\n    stored in repository files.\n\nUsage:\n    from modules.phishing_orchestrator import PhishingOrchestrator\n    phish = PhishingOrchestrator()\n    campaign_id = phish.launch(\n        target_domain=\"target.com\",\n        template=\"microsoft_365_login\",\n        mode=\"credential_harvest\",\n    )","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/phishing_orchestrator.py::CampaignTarget","modules/phishing_orchestrator.py::PhishingTemplate","modules/phishing_orchestrator.py::CampaignResult","modules/phishing_orchestrator.py::PhishingOrchestrator"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
