{"uid":"cli/commands/ux.py::UxCommandSet.do_toast","name":"do_toast","qualname":"UxCommandSet.do_toast","kind":"method","file":"cli/commands/ux.py","line":167,"end_line":258,"language":"py","signature":"def do_toast(self, line)","params":[{"name":"line","annotation":"","default":"","kind":"positional"}],"returns":"","decorators":["cmd2.with_category('12. Miscellaneous')"],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Raise a toast notification inside the cmd2 shell.","description":"The shell already renders toasts after every command; this command\nlets you raise one yourself. Use it to flag state changes for\nyourself or for a teammate tailing the same session. The persistent\nascii panel is the default; ``--live`` renders the same event as a\nsonner-style auto-expiring line through the shared toast bus.\n\nUsage:\n    ``toast <message>``                      — info level\n    ``toast <message> --level success``      — success / warn / error\n    ``toast <message> --type beacon``        — custom label\n    ``toast <message> --now``                — print immediately\n    ``toast <message> --live``               — ephemeral line, auto-erases on TTY\n    ``toast <message> --live --duration 2``  — ephemeral with 2s delay\n    ``toast <message> --dry-run``            — show what would be written","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"cli/commands/ux.py::UxCommandSet","members":[],"inferred_raises":[],"returns_value":false,"value":"","base_uids":[],"subclasses":[],"calls":["cli/output_mode.py::dry_run_line","cli/toast_bus.py::emit_toast","cli/toast_bus.py::render_ephemeral_toasts","cli/toast_bus.py::render_toasts","core/console.py::print_error","core/console.py::print_msg","core/console.py::print_warn"],"called_by":[]}
