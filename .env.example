# Copy to .env and edit. .env is gitignored.

# Flask session secret. If unset, a cryptographically random key is generated
# and persisted under sessions/.secret_key (see SecretKeyManager); there is no
# hardcoded fallback. A per-startup UUID4 is appended, so sessions reset on
# every restart unless you pin this value. Set it in production to a stable
# random 64+ char string so sessions survive restarts and span instances.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
LAZYOWN_SECRET_KEY=
