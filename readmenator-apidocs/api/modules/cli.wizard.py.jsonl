{"uid":"cli/wizard.py::check_binaries","name":"check_binaries","qualname":"check_binaries","kind":"function","file":"cli/wizard.py","line":947,"end_line":985,"language":"py","signature":"def check_binaries(specs: Sequence[BinarySpec] = _REQUIRED_BINARIES, which: Callable[[str], str | None] = shutil.which) -> list[BinaryStatus]","params":[{"name":"specs","annotation":"Sequence[BinarySpec]","default":"_REQUIRED_BINARIES","kind":"positional"},{"name":"which","annotation":"Callable[[str], str | None]","default":"shutil.which","kind":"positional"}],"returns":"list[BinaryStatus]","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Return the presence status of every spec without executing it.","description":"The check is intentionally side-effect free: it only resolves the\nbinary on ``PATH`` via ``shutil.which`` (or the caller-supplied\nequivalent in tests) and never spawns the discovered process. That\nkeeps the readiness step deterministic and removes the risk that a\npoisoned ``PATH`` entry could be triggered just by running ``wizard``.","params":[{"name":"specs","type":"","description":"Iterable of :class:`BinarySpec` definitions to verify. Defaults to :data:`_REQUIRED_BINARIES`.","default":""},{"name":"which","type":"","description":"``shutil.which``-compatible callable. Injected so unit\ntests can stub presence detection without touching the\nreal ``PATH``.","default":""}],"returns":{"name":"","type":"","description":"A list of :class:`BinaryStatus` items in the same order as\n``specs``. Binaries whose name fails :data:`_BINARY_NAME_RE`\nare skipped defensively — the module-level constants always\nmatch, but this guards against future contributions adding\nunsafe entries by mistake.","default":""},"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"google"},"parent":"cli/wizard.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["cli/wizard.py::BinaryStatus"],"called_by":["cli/wizard.py::run"]}
