_overlay.py","members":["cli/palette_overlay.py::PaletteOverlayConfig.title","cli/palette_overlay.py::PaletteOverlayConfig.subtitle","cli/palette_overlay.py::PaletteOverlayConfig.input_placeholder","cli/palette_overlay.py::PaletteOverlayConfig.recents_section_label","cli/palette_overlay.py::PaletteOverlayConfig.results_section_label","cli/palette_overlay.py::PaletteOverlayConfig.empty_message","cli/palette_overlay.py::PaletteOverlayConfig.max_rows","cli/palette_overlay.py::PaletteOverlayConfig.summary_max_chars","cli/palette_overlay.py::PaletteOverlayConfig.name_min_width","cli/palette_overlay.py::PaletteOverlayConfig.truncation_suffix","cli/palette_overlay.py::PaletteOverlayConfig.recents_boost","cli/palette_overlay.py::PaletteOverlayConfig.exact_match_boost","cli/palette_overlay.py::PaletteOverlayConfig.prefix_match_boost","cli/palette_overlay.py::PaletteOverlayConfig.substring_match_boost","cli/palette_overlay.py::PaletteOverlayConfig.payload_theme_key"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":["cli/palette_overlay.py::build_state"]}
