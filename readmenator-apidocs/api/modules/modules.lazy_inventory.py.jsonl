{"uid":"modules/lazy_inventory.py::LINUX_BLOB","name":"LINUX_BLOB","qualname":"LINUX_BLOB","kind":"constant","file":"modules/lazy_inventory.py","line":24,"end_line":33,"language":"py","signature":"LINUX_BLOB","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"","description":"","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"modules/lazy_inventory.py","members":[],"inferred_raises":[],"returns_value":null,"value":"'\\n'.join(['set -u', 'mkdir -p /tmp/lazyinv', \"{ echo '#LAZYINVENTORY linux'; uname -r; dpkg-query -W -f='${Package}\\\\t${Version}\\\\n' 2>/dev/null || rpm -qa --qf '%{NAME}\\\\t%{VERSION}\\\\n' 2>/dev/null || apk info -v 2>/dev/null; python3 -m pip list --format=freeze 2>/dev/null | sed 's/==/\\\\t/g'; } > /tmp/lazyinv/packages.tsv\", 'echo LAZYINVENTORY_DONE']) + '\\n'","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
