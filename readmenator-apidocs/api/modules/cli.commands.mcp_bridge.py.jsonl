{"uid":"cli/commands/mcp_bridge.py::McpBridgeCommandSet.do_playbook_run","name":"do_playbook_run","qualname":"McpBridgeCommandSet.do_playbook_run","kind":"method","file":"cli/commands/mcp_bridge.py","line":431,"end_line":486,"language":"py","signature":"def do_playbook_run(self, args: argparse.Namespace) -> None","params":[{"name":"args","annotation":"argparse.Namespace","default":"","kind":"positional"}],"returns":"None","decorators":["with_category(ai_category)","with_argparser(_build_playbook_run_parser())"],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Execute a generated YAML playbook step by step through the shell.","description":"Each step command runs via the interactive shell so aliases and hooks\napply. Defaults to the newest ``sessions/playbook_*.yaml``. Mirrors\nthe ``lazyown_playbook_run`` MCP tool.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"cli/commands/mcp_bridge.py::McpBridgeCommandSet","members":[],"inferred_raises":[],"returns_value":false,"value":"","base_uids":[],"subclasses":[],"calls":["core/console.py::print_error","core/console.py::print_msg","modules/playbook_engine.py::PlaybookEngine.__init__","modules/playbook_engine.py::PlaybookEngine.execute","modules/playbook_engine.py::PlaybookEngine.load","modules/playbook_engine.py::PlaybookEngine.result_summary"],"called_by":[]}
{"uid":"cli/commands/mcp_bridge.py::McpBridgeCommandSet.do_auto_loop","name":"do_auto_loop","qualname":"McpBridgeCommandSet.do_auto_loop","kind":"method","file":"cli/commands/mcp_bridge.py","line":489,"end_line":531,"language":"py","signature":"def do_auto_loop(self, line: str) -> None","params":[{"name":"line","annotation":"str","default":"","kind":"positional"}],"returns":"None","decorators":["with_category(ai_category)"],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Run a goal through the single lazy orchestrator (auto_loop == lazy_loop).","description":"Usage:\n    auto_loop [--target T] [--task T] [--rounds N] [--workers N]\n              [--timeout S] [--targets-from-file F] [--max-concurrent N]\n              [--step-delay S] [--budget rounds=N,toolcalls=N,findings=N,timeout_sec=N]\n              [--budget-confirm] [--no-bootstrap] [--fallback-phish]\n              [--mode pentest|redteam|ctf]\n              [--view|--plain] <goal>\n\nBoth commands share one runner (``modules.lazy_runner``): one\nengine, one chain, one terminal-safety path. ``--view`` opens\nthe live worker monitor instead of the milestone panel.\n``--budget`` caps the run at the engine level (rounds, tool\ncalls, findings, wall clock); ``--budget-confirm`` gates the\nstart behind an interactive confirmation unless\n``LAZYOWN_AUTONOMOUS=1``. ``--fallback-phish`` stages a client-\nsubject phishing handoff (keyless shortener lure, offline\npreviews unless SMTP lives in payload.json) when the run ends\nwith no foothold.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"cli/commands/mcp_bridge.py::McpBridgeCommandSet","members":[],"inferred_raises":[],"returns_value":false,"value":"","base_uids":[],"subclasses":[],"calls":["core/console.py::print_error","modules/lazy_runner.py::parse_loop_line","modules/lazy_runner.py::run_loop"],"called_by":[]}
