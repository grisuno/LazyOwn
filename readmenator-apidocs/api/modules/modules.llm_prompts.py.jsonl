{"uid":"modules/llm_prompts.py","name":"llm_prompts.py","qualname":"modules/llm_prompts.py","kind":"module","file":"modules/llm_prompts.py","line":1,"end_line":503,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Canonical prompt-template and knowledge-base contract for LLM consumers.","description":"Owns every task-domain prompt template used by the Groq chat family and the\nstructured helpers (truncation, knowledge-base CRUD, relevance filtering,\npayload/event context loading) that were previously duplicated across the\nretired ``modules.legacy.lazygptcli*`` scripts.\n\nThis module is pure: it never imports a vendor SDK, never performs network\ncalls, and never reads process environment directly. All filesystem locations\nand tunables are resolved through :class:`LlmPromptConfig` so tests can point\nevery read/write at temporary fixtures.\n\nUsage::\n\n    from modules.llm_prompts import LlmPromptConfig, KnowledgeStore\n\n    config = LlmPromptConfig(project_root=\"/tmp/x\")\n    store = config.knowledge_store(\"vuln\")\n    kb = store.relevant(\"nmap output\", limit=5)\n    prompt = config.render(\"vuln\", \"raw nmpa output\", context=ctx)","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["modules/llm_prompts.py::PROMPT_MAX_CHARS","modules/llm_prompts.py::KNOWLEDGE_TAIL_LIMIT","modules/llm_prompts.py::DEFAULT_SYSTEM_PROMPT","modules/llm_prompts.py::KB_FILE_NAMES","modules/llm_prompts.py::PAYLOAD_KEY_ORDER","modules/llm_prompts.py::default_project_root","modules/llm_prompts.py::resolve_model","modules/llm_prompts.py::truncate_message","modules/llm_prompts.py::LlmPromptConfig","modules/llm_prompts.py::render_kb_tail","modules/llm_prompts.py::KnowledgeStore","modules/llm_prompts.py::TEMPLATES","modules/llm_prompts.py::TEMPLATE_MODELS","modules/llm_prompts.py::TEMPLATE_KB_DOMAINS"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
